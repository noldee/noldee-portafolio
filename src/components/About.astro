---
import SocialIcon from "./icons/SocialIcon.astro";
---

<section class="mt-36 md:mt-24">
  <div class="flex items-center gap-x-2 rounded text-sm">
    <div class="w-3 h-3 opacity-75 bg-[#3481fe] rounded-full animate-spin">
      <span
        class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#3481fe] opacity-75"
      ></span>
    </div>
    <span>Disponible para trabajar</span>
  </div>
  <div class="flex flex-col space-y-4">
    <h2 class="text-6xl md:text-7xl font-black capitalize mt-7">
      Walter Soca
    </h2>
    <span class="md:text-xl font-normal">Desarrollador de Software :3</span>
    <p class="font-normal text-sm md:text-xl md:w-4/6 text-gray-400">
      Construyo aplicaciones web rápidas, escalables y orientadas al negocio.
      Foco en performance, SEO y experiencia de usuario.
    </p>

    <div class="flex gap-x-3">
      <SocialIcon href="https://github.com/noldee">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
          class="size-5"
          ><title>Github</title><path
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2c2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2a4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6c-.6.6-.6 1.2-.5 2V21"
          ></path></svg
        >
      </SocialIcon>
      <SocialIcon href="mailto:socamezareswalter@gmail.com">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
          class="size-5"
          ><title>Mail</title><path
            d="M18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64z"
            fill="currentColor"></path></svg
        >
      </SocialIcon>
      <SocialIcon
        href="https://www.linkedin.com/in/walter-soca-mezares-5b158b3b0/"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 640 640"
          class="size-5"
          ><title>LinkedIn</title><path
            fill="currentColor"
            d="M512 96H127.9C110.3 96 96 110.5 96 128.3v383.4c0 17.8 14.3 32.3 31.9 32.3H512c17.6 0 32-14.5 32-32.3V128.3c0-17.8-14.4-32.3-32-32.3M231.4 480H165V266.2h66.5V480zm-33.2-320c21.3 0 38.5 17.2 38.5 38.5S219.5 237 198.2 237s-38.5-17.2-38.5-38.5s17.2-38.5 38.5-38.5m282.1 320h-66.4V376c0-24.8-.5-56.7-34.5-56.7c-34.6 0-39.9 27-39.9 54.9V480h-66.4V266.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5c67.2 0 79.7 44.3 79.7 101.9z"
          ></path></svg
        >
      </SocialIcon>
    </div>
  </div>
</section>
