---
import SocialIcon from "./icons/SocialIcon.astro";
---

<section class="relative pt-15 pb-20 overflow-hidden">
  <div
    class="absolute inset-0 -z-10 h-full w-full bg-white bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_70%,transparent_100%)]"
  >
  </div>

  <div class="max-w-6xl mx-auto px-6">
    <div
      id="hero-badge"
      class="inline-flex items-center gap-x-2 bg-blue-50 border border-blue-100 px-3 py-1 rounded-full text-xs font-medium text-blue-600 mb-8"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"
        ></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"
        ></span>
      </span>
      Disponible para trabajar
    </div>

    <div class="flex flex-col space-y-6">
      <h1
        id="hero-title"
        class="text-5xl md:text-8xl font-extrabold tracking-tight text-black leading-[1.1]"
      >
        Walter Soca<span
          class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500"
          >.</span
        >
      </h1>

      <p
        id="hero-p"
        class="text-lg md:text-2xl text-gray-500 max-w-3xl leading-relaxed font-normal"
      >
        Construyo aplicaciones web <span class="text-black font-semibold"
          >rápidas, escalables</span
        > y orientadas al negocio. Foco en performance, SEO y experiencia de usuario.
      </p>

      <div id="hero-actions" class="flex flex-wrap items-center gap-6 pt-4">
        <a
          href="#proyectos"
          class="bg-black text-white px-8 py-3 rounded-xl font-medium hover:bg-gray-800 transition-all shadow-xl shadow-gray-200"
        >
          Explorar Proyectos
        </a>

        <div class="flex items-center gap-x-4 border-l border-gray-200 md:pl-6">
          <SocialIcon
            href="https://github.com/noldee"
            className="text-gray-400 hover:text-blue-600 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-6"
              ><path
                d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
              ></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
            >
          </SocialIcon>

          <SocialIcon
            href="mailto:socamezareswalter@gmail.com"
            className="text-gray-400 hover:text-blue-600 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-6"
              ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
                d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
            >
          </SocialIcon>

          <SocialIcon
            href="https://www.linkedin.com/in/walter-soca-mezares-5b158b3b0/"
            className="text-gray-400 hover:text-blue-600 transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-6"
              ><path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
              ></path><rect width="4" height="12" x="2" y="9"></rect><circle
                cx="4"
                cy="4"
                r="2"></circle></svg
            >
          </SocialIcon>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  // Animación tipo SaaS al cargar la página
  window.addEventListener("DOMContentLoaded", () => {
    const tl = gsap.timeline();

    tl.from("#hero-badge", {
      opacity: 0,
      scale: 0.9,
      duration: 0.5,
      ease: "back.out(1.7)",
    })
      .from(
        "#hero-title",
        { opacity: 0, y: 30, duration: 0.8, ease: "power4.out" },
        "-=0.3",
      )
      .from(
        "#hero-p",
        { opacity: 0, y: 20, duration: 0.8, ease: "power4.out" },
        "-=0.5",
      )
      .from(
        "#hero-actions",
        { opacity: 0, y: 10, duration: 0.8, ease: "power4.out" },
        "-=0.5",
      );
  });
</script>
