---
import DownloadButton from "./DownloadButton.astro";
import Enlace from "./Enlace.astro";
---

<header
  class="sticky top-0 z-[100] w-full border-b border-gray-100 bg-white/80 backdrop-blur-md"
>
  <div class="max-w-6xl mx-auto flex justify-between items-center py-4 px-6">
    <a href="/" class="flex items-center gap-2 group z-[120]">
   
      <h2 class="text-xl font-bold tracking-tighter text-black uppercase">
        Noldee
      </h2>
    </a>

    <div class="flex items-center gap-6">
      <nav
        class="hidden md:flex items-center gap-x-8 text-sm font-medium text-gray-500"
      >
        <Enlace
          class="hover:text-blue-600 transition-colors"
          href="/"
          title="Inicio"
        />
        <Enlace
          class="hover:text-blue-600 transition-colors"
          href="#proyectos"
          title="Proyectos"
        />
        <Enlace
          class="hover:text-blue-600 transition-colors"
          href="/blog"
          title="Blog"
        />
        <Enlace
          class="hover:text-blue-600 transition-colors"
          href="#contacto"
          title="Contacto"
        />
      </nav>

      <div class="hidden md:block">
        <DownloadButton />
      </div>

      <button
        id="menu-toggle"
        aria-label="Menu"
        class="relative z-[120] md:hidden flex flex-col justify-center items-end size-10 gap-[6px] group"
      >
        <span
          class="line w-7 h-[2px] bg-black rounded-full transition-all duration-300"
        ></span>
        <span
          class="line w-5 h-[2px] bg-black rounded-full transition-all duration-300 group-hover:w-7"
        ></span>
        <span
          class="line w-7 h-[2px] bg-black rounded-full transition-all duration-300"
        ></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="fixed inset-0 w-full h-screen bg-white z-[110] flex flex-col items-center justify-center opacity-0 pointer-events-none"
  >
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:20px_20px] opacity-40"
    >
    </div>

    <nav class="flex flex-col items-center gap-y-8 w-full px-10">
      <div class="overflow-hidden">
        <a
          href="/"
          class="mobile-link block text-5xl font-black text-black tracking-tighter hover:text-blue-600 transition-colors"
          >Inicio</a
        >
      </div>
      <div class="overflow-hidden">
        <a
          href="#proyectos"
          class="mobile-link block text-5xl font-black text-black tracking-tighter hover:text-blue-600 transition-colors"
          >Proyectos</a
        >
      </div>
      <div class="overflow-hidden">
        <a
          href="/blog"
          class="mobile-link block text-5xl font-black text-black tracking-tighter hover:text-blue-600 transition-colors"
          >Blog</a
        >
      </div>
      <div class="overflow-hidden">
        <a
          href="#contacto"
          class="mobile-link block text-5xl font-black text-black tracking-tighter hover:text-blue-600 transition-colors"
          >Contacto</a
        >
      </div>

      <div class="mobile-link-btn mt-8 opacity-0 translate-y-4">
        <DownloadButton />
      </div>
    </nav>

    <div class="absolute bottom-12 flex flex-col items-center gap-2">
      <span class="text-xs font-bold text-gray-400 uppercase tracking-widest"
        >Connect with me</span
      >
      <div class="h-px w-8 bg-gray-200"></div>
    </div>
  </div>
</header>

<script>
  import { gsap } from "gsap";

  const menuToggle = document.querySelector("#menu-toggle");
  const mobileMenu = document.querySelector("#mobile-menu");
  const lines = document.querySelectorAll(".line");
  const mobileLinks = document.querySelectorAll(".mobile-link");
  const mobileBtn = document.querySelector(".mobile-link-btn");

  let isOpen = false;

  // Timeline para el menú (Full Screen Reveal)
  const menuTl = gsap.timeline({ paused: true });

  menuTl
    .to(mobileMenu, {
      opacity: 1,
      pointerEvents: "auto",
      duration: 0.5,
      ease: "power4.inOut",
    })
    .from(
      mobileLinks,
      {
        y: 100,
        stagger: 0.1,
        duration: 0.8,
        ease: "power4.out",
      },
      "-=0.2",
    )
    .to(
      mobileBtn,
      {
        opacity: 1,
        y: 0,
        duration: 0.4,
      },
      "-=0.4",
    );

  menuToggle?.addEventListener("click", () => {
    isOpen = !isOpen;

    if (isOpen) {
      // Transformación de Hamburguesa a X
      gsap.to(lines[0], {
        y: 8,
        rotation: 45,
        duration: 0.4,
        ease: "power4.inOut",
      });
      gsap.to(lines[1], { width: 0, opacity: 0, duration: 0.2 });
      gsap.to(lines[2], {
        y: -8,
        rotation: -45,
        duration: 0.4,
        ease: "power4.inOut",
      });

      menuTl.play();
      document.body.style.overflow = "hidden";
    } else {
      gsap.to(lines[0], { y: 0, rotation: 0, duration: 0.4 });
      gsap.to(lines[1], { width: "1.25rem", opacity: 1, duration: 0.3 });
      gsap.to(lines[2], { y: 0, rotation: 0, duration: 0.4 });

      menuTl.reverse();
      document.body.style.overflow = "auto";
    }
  });

  // Cerrar al clickear links
  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      isOpen = false;
      gsap.to(lines[0], { y: 0, rotation: 0, duration: 0.4 });
      gsap.to(lines[1], { width: "1.25rem", opacity: 1, duration: 0.3 });
      gsap.to(lines[2], { y: 0, rotation: 0, duration: 0.4 });
      menuTl.reverse();
      document.body.style.overflow = "auto";
    });
  });
</script>
