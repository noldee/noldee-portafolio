---

---

<section class="relative pt-20 pb-28 overflow-hidden">
  <div class="max-w-5xl mx-auto px-6">
    <!-- Badge disponible -->
    <div class="inline-flex items-center gap-2 mb-10">
      <span class="relative flex h-2 w-2">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--green)] opacity-60"
        ></span>
        <span
          class="relative inline-flex rounded-full h-2 w-2 bg-[var(--green)]"
        ></span>
      </span>
      <span
        class="text-xs font-mono text-[var(--text-muted)] uppercase tracking-widest"
      >
        disponible para trabajar
      </span>
    </div>

    <!-- Nombre -->
    <h1
      id="hero-title"
      class="text-6xl md:text-[8rem] font-display tracking-tight text-[var(--text)] leading-[0.92] uppercase mb-8"
    >
      Walter<br />
      <span class="text-[var(--green)]">Soca</span>
    </h1>

    <!-- Descripción -->
    <p
      id="hero-p"
      class="text-lg md:text-xl text-[var(--text-muted)] max-w-xl leading-relaxed mb-10 border-l-2 border-[var(--green)] pl-5"
    >
      Construyo aplicaciones web <span class="text-[var(--text)]"
        >rápidas, escalables</span
      > y orientadas al negocio. Foco en performance y UX.
    </p>

    <!-- Acciones -->
    <div id="hero-actions" class="flex flex-wrap items-center gap-4">
      <a
        href="#proyectos"
        class="bg-[var(--green)] text-black px-6 py-2.5 text-sm font-semibold hover:bg-[var(--green-dim)] hover:text-white transition-all"
      >
        Ver proyectos
      </a>

      <div class="flex items-center gap-3">
        {
          [
            {
              href: "https://github.com/noldee",
              label: "GitHub",
              icon: "github",
            },
            {
              href: "mailto:socamezareswalter@gmail.com",
              label: "Email",
              icon: "mail",
            },
            {
              href: "https://www.linkedin.com/in/walter-soca-mezares-5b158b3b0/",
              label: "LinkedIn",
              icon: "linkedin",
            },
          ].map((social) => (
            <a
              href={social.href}
              target="_blank"
              aria-label={social.label}
              class="p-2.5 border border-[var(--border)] text-[var(--text-muted)] hover:text-[var(--green)] hover:border-[var(--green)] transition-all"
            >
              {social.icon === "github" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                  <path d="M9 18c-4.51 2-5-2-7-2" />
                </svg>
              )}
              {social.icon === "mail" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect width="20" height="16" x="2" y="4" rx="2" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
              )}
              {social.icon === "linkedin" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                  <rect width="4" height="12" x="2" y="9" />
                  <circle cx="4" cy="4" r="2" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  window.addEventListener("DOMContentLoaded", () => {
    const tl = gsap.timeline();
    tl.from("#hero-title", {
      y: 30,
      opacity: 0,
      duration: 0.7,
      ease: "power3.out",
    })
      .from("#hero-p", { y: 20, opacity: 0, duration: 0.5 }, "-=0.4")
      .from("#hero-actions", { y: 15, opacity: 0, duration: 0.5 }, "-=0.3");
  });
</script>
