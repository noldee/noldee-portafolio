---

---

<section
  class="relative pt-16 pb-24 overflow-hidden bg-white dark:bg-zinc-900 transition-colors duration-300"
>
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] dark:bg-[radial-gradient(#ffffff10_1px,transparent_1px)] [background-size:20px_20px] opacity-40"
  >
  </div>

  <div class="max-w-6xl mx-auto px-6">
    <div
      id="hero-badge"
      class="inline-flex items-center gap-x-2 bg-yellow-300 border-2 border-black px-4 py-1 mb-10 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] font-bold text-xs uppercase text-black"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"
        ></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-red-600"
        ></span>
      </span>
      Disponible para trabajar
    </div>

    <div class="flex flex-col space-y-8">
      <h1
        id="hero-title"
        class="text-6xl md:text-9xl font-black tracking-tighter text-black dark:text-white leading-[0.9] uppercase italic"
      >
        Walter <span
          class="text-blue-600 drop-shadow-[4px_4px_0px_rgba(0,0,0,1)] dark:drop-shadow-[4px_4px_0px_rgba(255,255,255,1)]"
          >Soca</span
        >
      </h1>

      <p
        id="hero-p"
        class="text-xl md:text-3xl text-zinc-700 dark:text-zinc-300 max-w-2xl leading-tight font-bold border-l-8 border-black dark:border-white pl-6"
      >
        Construyo aplicaciones web <span class="bg-blue-600 text-white px-2"
          >rápidas, escalables</span
        > y orientadas al negocio. Foco en performance y UX.
      </p>

      <div id="hero-actions" class="flex flex-wrap items-center gap-6 pt-6">
        <a
          href="#proyectos"
          class="bg-blue-600 text-white border-4 border-black px-8 py-4 text-xl font-black uppercase shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px] transition-all"
        >
          Explorar Proyectos
        </a>

        <div class="flex items-center gap-4">
          {
            [
              { href: "https://github.com/noldee", icon: "github" },
              { href: "mailto:socamezareswalter@gmail.com", icon: "mail" },
              {
                href: "https://www.linkedin.com/in/walter-soca-mezares-5b158b3b0/",
                icon: "linkedin",
              },
            ].map((social) => (
              <a
                href={social.href}
                target="_blank"
                class="border-2 border-black p-3 bg-white dark:bg-zinc-800 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all dark:text-white"
              >
                {social.icon === "github" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                    <path d="M9 18c-4.51 2-5-2-7-2" />
                  </svg>
                )}
                {social.icon === "mail" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect width="20" height="16" x="2" y="4" rx="2" />
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                  </svg>
                )}
                {social.icon === "linkedin" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                    <rect width="4" height="12" x="2" y="9" />
                    <circle cx="4" cy="4" r="2" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  window.addEventListener("DOMContentLoaded", () => {
    const tl = gsap.timeline();

    tl.from("#hero-badge", {
      x: -50,
      opacity: 0,
      duration: 0.4,
      ease: "power4.out",
    })
      .from(
        "#hero-title",
        {
          scale: 0.8,
          opacity: 0,
          duration: 0.6,
          ease: "back.out(1.7)",
        },
        "-=0.2",
      )
      .from(
        "#hero-p",
        {
          x: -30,
          opacity: 0,
          duration: 0.5,
        },
        "-=0.3",
      )
      .from(
        "#hero-actions",
        {
          y: 30,
          opacity: 0,
          duration: 0.5,
        },
        "-=0.3",
      );
  });
</script>
