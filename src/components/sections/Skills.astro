---
import { techIcons } from "@/lib/techIcons";
import LogoLoop from "../animations/LogoLoop";

const techLogos = Object.entries(techIcons).map(([name, src]) => ({
  src: src,
  alt: name,
}));
---

<section id="sobre-mi" class="py-16 md:py-20 border-t border-[var(--border)] bg-[var(--bg-main)]">
  <div class="max-w-4xl mx-auto px-6">
    
    <!-- Diseño Tabular Limpio -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 items-start mb-12">
      <div class="md:col-span-1">
        <!-- Título básico sin símbolos raros -->
        <h2 class="text-lg font-bold text-[var(--text-main)] tracking-tight">Sobre mí</h2>
      </div>

      <div class="md:col-span-2 text-base text-[var(--text-muted)] leading-relaxed">
        <p>
          Soy un apasionado de la optimización. Me encanta trabajar en entornos donde el rendimiento cuenta, construyendo con arquitecturas sólidas, código limpio y soluciones web modernas.
        </p>
      </div>
    </div>

    <!-- Contenedor del Stack - Estilo Caja de Tarjeta Básica -->
    <div class="border border-[var(--border)] bg-[var(--bg-card)] rounded-xl overflow-hidden shadow-sm">
      <!-- Encabezado sutil de la caja -->
      <div class="px-5 py-3 border-b border-[var(--border)] bg-[var(--bg-main)] flex justify-between items-center">
        <span class="text-xs font-medium text-[var(--text-muted)]">
          Tecnologías y herramientas
        </span>
        <span class="w-2 h-2 rounded-full bg-[var(--accent)]"></span>
      </div>

      <!-- Área de Logos (El carrusel animado) -->
      <div class="p-6 bg-[var(--bg-card)]">
        <LogoLoop
          logos={techLogos}
          speed={35}
          direction="left"
          logoHeight={28}
          gap={48}
          client:visible
        />
      </div>
    </div>

  </div>
</section>

<style is:global>
  /* Filtro de los logos adaptado a la nueva paleta de grises */
  .logo-item {
    filter: grayscale(1) opacity(0.4);
    transition: filter 0.2s ease, opacity 0.2s ease;
  }

  /* Al pasar el mouse, recuperan color suavemente */
  .logo-item:hover {
    filter: grayscale(0) opacity(0.9);
  }
</style>