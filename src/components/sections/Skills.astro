---
import { techIcons } from "@/lib/techIcons";
import LogoLoop from "../animations/LogoLoop";

const techLogos = Object.entries(techIcons).map(([name, src]) => ({
  src: src,
  alt: name,
}));
---

<section class="py-20 border-t border-[#222225] bg-[#0b0b0c]">
  <div class="max-w-5xl mx-auto px-4">
    <!-- Diseño Tabular -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start mb-16">
      <div class="md:col-span-1">
        <h2 class="text-xl font-bold text-[#fbebca]">[01] sobre_mí</h2>
      </div>

      <div class="md:col-span-2 space-y-4 text-sm sm:text-base">
        <p class="text-[#fbfaf7] leading-relaxed">
          Soy un apasionado de la optimización. Me encanta trabajar en entornos
          donde cada milisegundo cuenta, construyendo con arquitecturas lógicas
          sólidas y modernas.
        </p>
      </div>
    </div>

    <!-- Caja de Stack - Estilo Caja de Documentación de Bun/Deno -->
    <div
      class="border border-[#222225] bg-[#131315] rounded-2xl overflow-hidden shadow-2xl"
    >
      <div
        class="px-5 py-3 border-b border-[#222225] bg-[#0e0e10] flex justify-between items-center"
      >
        <span class="text-xs font-semibold text-[#8c8c93]">
          $ bun x tech-stack --list
        </span>
        <span
          class="text-[10px] text-[#ff847c] bg-[#ff847c]/10 px-2 py-0.5 rounded-md font-bold"
        >
          v1.0.0
        </span>
      </div>

      <div class="p-6 sm:p-8 bg-[#131315]">
        <LogoLoop
          logos={techLogos}
          speed={35}
          direction="left"
          logoHeight={30}
          gap={60}
          client:visible
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Logos adaptados al nuevo contraste crema/retro */
  .logo-item {
    filter: grayscale(1) invert(0.9) brightness(0.9);
    opacity: 0.5;
    transition:
      filter 0.2s ease,
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .logo-item:hover {
    filter: grayscale(0) invert(0) brightness(1);
    opacity: 1;
    transform: translateY(-2px); /* Pequeña elevación estilo Deno */
  }
</style>
