---
import { techIcons } from "@/lib/techIcons";
import LogoLoop from "../animations/LogoLoop";

const techLogos = Object.entries(techIcons).map(([name, src]) => ({
  src: src,
  alt: name,
}));
---

<section class="py-24 border-t border-[var(--border)]">
  <div class="max-w-5xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start mb-20">
      <div>
        <span
          class="text-xs font-mono text-[var(--green)] tracking-widest uppercase mb-4 block"
        >
        </span>
        <h2
          class="text-5xl md:text-6xl font-display text-[var(--text)] leading-none mb-0"
        >
          Sobre mí
        </h2>
      </div>

      <div class="border-l border-[var(--border)] pl-8">
        <p class="text-[var(--text)] text-lg leading-relaxed mb-4">
          Soy <span class="text-[var(--green)]">Walter</span>, desarrollador de
          software con pasión por crear soluciones web modernas.
        </p>
        <p class="text-[var(--text-muted)] text-base leading-relaxed">
          Me especializo en transformar ideas complejas en interfaces potentes.
          Focalizado en la escalabilidad, siempre buscando la excelencia técnica
          en cada línea de código.
        </p>
      </div>
    </div>

    <!-- Stack -->
    <div
      class="border border-[var(--border)] bg-[var(--surface)] rounded-sm overflow-hidden"
    >
      <div
        class="px-6 py-3 border-b border-[var(--border)] flex justify-between items-center"
      >
        <span
          class="text-xs font-mono text-[var(--text-muted)] uppercase tracking-widest"
          >stack</span
        >
        <span class="text-xs font-mono text-[var(--green)]">● activo</span>
      </div>

      <div class="p-8">
        <div class="flex items-center">
          <LogoLoop
            logos={techLogos}
            speed={40}
            direction="left"
            logoHeight={40}
            gap={80}
            hoverSpeed={5}
            scaleOnHover
            ariaLabel="Tecnologías que utilizo"
            client:visible
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .logo-item {
    filter: brightness(0) invert(0.6);
    transition:
      filter 0.3s ease,
      transform 0.2s ease;
  }
  .logo-item:hover {
    filter: brightness(0) invert(1);
    transform: scale(1.1);
  }
</style>
