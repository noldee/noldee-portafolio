---
const redesSociales = [
  { nombre: "GitHub", url: "https://github.com/noldee" },
  {
    nombre: "LinkedIn",
    url: "https://www.linkedin.com/in/walter-soca-mezares-5b158b3b0/",
  },
  { nombre: "Instagram", url: "https://instagram.com/noldesito" },
];
---

<section id="contacto" class="py-24 border-t border-[var(--border)]">
  <div class="max-w-5xl mx-auto px-6">
    <div class="mb-16">
      <span
        class="text-xs font-mono text-[var(--green)] tracking-widest uppercase mb-4 block"
      ></span>
      <h2
        class="text-5xl md:text-6xl font-display text-[var(--text)] leading-none mb-4"
      >
        Contacto
      </h2>
      <p class="text-sm font-mono text-[var(--text-muted)]">
        estado: <span class="text-[var(--green)]"
          >disponible para proyectos</span
        >
      </p>
    </div>

    <!-- Formulario -->
    <div
      class="border border-[var(--border)] bg-[var(--surface)] p-8 md:p-12 mb-16 max-w-2xl"
    >
      <form class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="field-container">
            <label
              class="block text-xs font-mono text-[var(--text-muted)] uppercase tracking-widest mb-2"
            >
              nombre
            </label>
            <input
              type="text"
              placeholder="Tu nombre"
              class="w-full bg-[var(--bg)] border border-[var(--border)] px-4 py-3 text-sm text-[var(--text)] font-mono placeholder:text-[var(--text-dim)] focus:border-[var(--green)] focus:outline-none transition-colors"
            />
          </div>
          <div class="field-container">
            <label
              class="block text-xs font-mono text-[var(--text-muted)] uppercase tracking-widest mb-2"
            >
              email
            </label>
            <input
              type="email"
              placeholder="tu@correo.com"
              class="w-full bg-[var(--bg)] border border-[var(--border)] px-4 py-3 text-sm text-[var(--text)] font-mono placeholder:text-[var(--text-dim)] focus:border-[var(--green)] focus:outline-none transition-colors"
            />
          </div>
        </div>

        <div class="field-container">
          <label
            class="block text-xs font-mono text-[var(--text-muted)] uppercase tracking-widest mb-2"
          >
            mensaje
          </label>
          <textarea
            rows="4"
            placeholder="¿En qué puedo ayudarte?"
            class="w-full bg-[var(--bg)] border border-[var(--border)] px-4 py-3 text-sm text-[var(--text)] font-mono placeholder:text-[var(--text-dim)] focus:border-[var(--green)] focus:outline-none transition-colors resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="bg-[var(--green)] text-black px-6 py-2.5 text-sm font-semibold hover:bg-[var(--green-dim)] hover:text-white transition-all"
        >
          Enviar mensaje →
        </button>
      </form>
    </div>

    <!-- Email directo -->
    <div class="mb-20">
      <p
        class="text-xs font-mono text-[var(--text-muted)] uppercase tracking-widest mb-3"
      >
        o directo al correo
      </p>
      <a
        href="mailto:socamezareswalter@gmail.com"
        class="text-xl md:text-2xl font-display text-[var(--text)] hover:text-[var(--green)] transition-colors"
      >
        socamezareswalter@gmail.com
      </a>
    </div>

    <!-- Footer -->
    <footer
      class="border-t border-[var(--border)] pt-10 flex flex-col md:flex-row justify-between items-start md:items-end gap-6"
    >
      <div>
        <p class="text-2xl font-display text-[var(--text)] mb-2">Walter Soca</p>
        <div class="flex gap-3 text-xs font-mono text-[var(--text-muted)]">
          <span>Lima, Perú</span>
          <span>·</span>
          <span>© 2026</span>
        </div>
      </div>

      <nav class="flex gap-6">
        {
          redesSociales.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-mono text-[var(--text-muted)] hover:text-[var(--green)] transition-colors"
            >
              {social.nombre}
            </a>
          ))
        }
      </nav>
    </footer>
  </div>
</section>
