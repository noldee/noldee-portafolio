---
const redesSociales = [
  { nombre: "GitHub", url: "https://github.com/noldee" },
  { nombre: "LinkedIn", url: "https://www.linkedin.com/in/walter-soca-mezares-5b158b3b0/" },
  { nombre: "Instagram", url: "https://instagram.com/noldesito" },
];
---

<section id="contacto" class="py-16 md:py-20 border-t border-[var(--border)] bg-[var(--bg-main)]">
  <div class="max-w-4xl mx-auto px-6">
    
    <!-- Título de Sección Limpio -->
    <div class="mb-10">
      <h2 class="text-lg font-bold text-[var(--text-main)] tracking-tight">
        Contacto
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start mb-16">
      <!-- Bloque Izquierdo: Formulario Minimalista (7 columnas) -->
      <div class="md:col-span-7 border border-[var(--border)] bg-[var(--bg-card)] p-6 rounded-xl shadow-sm">
        <form class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-[var(--text-muted)] mb-1.5">
                Nombre
              </label>
              <input
                type="text"
                placeholder="Tu nombre"
                class="w-full bg-[var(--bg-main)] border border-[var(--border)] rounded-md px-3.5 py-2 text-sm text-[var(--text-main)] placeholder:text-[var(--text-muted)]/40 focus:border-[var(--accent)] focus:outline-none transition-colors"
              />
            </div>
            <div>
              <label class="block text-xs font-medium text-[var(--text-muted)] mb-1.5">
                Correo electrónico
              </label>
              <input
                type="email"
                placeholder="tu@correo.com"
                class="w-full bg-[var(--bg-main)] border border-[var(--border)] rounded-md px-3.5 py-2 text-sm text-[var(--text-main)] placeholder:text-[var(--text-muted)]/40 focus:border-[var(--accent)] focus:outline-none transition-colors"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-medium text-[var(--text-muted)] mb-1.5">
              Mensaje
            </label>
            <textarea
              rows="4"
              placeholder="¿En qué puedo ayudarte?"
              class="w-full bg-[var(--bg-main)] border border-[var(--border)] rounded-md px-3.5 py-2 text-sm text-[var(--text-main)] placeholder:text-[var(--text-muted)]/40 focus:border-[var(--accent)] focus:outline-none transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Botón de Envío Plano -->
          <button
            type="submit"
            class="w-full sm:w-auto text-sm font-semibold bg-[var(--accent)] hover:bg-[#4f46e5] text-white px-5 py-2.5 rounded-md transition-colors shadow-sm"
          >
            Enviar mensaje
          </button>
        </form>
      </div>

      <!-- Bloque Derecho: Información alternativa (5 columnas) -->
      <div class="md:col-span-5 md:pt-4 space-y-6">
        <div>
          <p class="text-xs font-medium text-[var(--text-muted)] mb-1.5">
            Correo directo
          </p>
          <a
            href="mailto:socamezareswalter@gmail.com"
            class="text-base font-semibold text-[var(--text-main)] hover:text-[var(--accent)] transition-colors break-all"
          >
            socamezareswalter@gmail.com
          </a>
        </div>

        <div class="p-4 bg-[var(--bg-card)]/40 border border-[var(--border)] rounded-lg text-xs text-[var(--text-muted)] leading-relaxed">
          <p>
            ¿Prefieres saltarte el formulario? Envíame un correo directamente. Suelo responder en menos de 24 horas laborables.
          </p>
        </div>
      </div>
    </div>

    <!-- Footer Unificado, Simple y Elegante -->
    <footer class="border-t border-[var(--border)] pt-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <p class="text-sm font-bold text-[var(--text-main)] tracking-tight">Walter Soca</p>
        <div class="flex gap-2 text-xs text-[var(--text-muted)] mt-1">
          <span>Lima, Perú</span>
          <span>·</span>
          <span>© 2026</span>
        </div>
      </div>

      <!-- Enlaces Limpios en el Footer -->
      <nav class="flex gap-4">
        {
          redesSociales.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors font-medium"
            >
              {social.nombre}
            </a>
          ))
        }
      </nav>
    </footer>
  </div>
</section>