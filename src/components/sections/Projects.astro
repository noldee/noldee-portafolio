---
const projects = [
  {
    title: "Gifs App",
    description:
      "Aplicación de alto rendimiento para la búsqueda y gestión de GIFs en tiempo real. Interfaz fluida, minimalista y totalmente responsiva.",
    image: "/images/proyecto-1.jpeg",
    live: "https://gifs-app-free.netlify.app/",
    github: "https://github.com/noldee/Gifs-App",
    stack: ["React", "Tailwind", "TypeScript"],
  },
  {
    title: "Modern User Manager",
    description:
      "Full-Stack REST API & Dashboard con arquitectura desacoplada. Backend con Java/Spring y Frontend con React.",
    image: "/images/proyecto-2.jpeg",
    live: "https://modern-user-manager.netlify.app/",
    github: "https://github.com/noldee/modern-user-manager",
    stack: ["React", "Spring Boot", "MySQL"],
  },
  {
    title: "Spotify Clone",
    description:
      "Clon de Spotify desarrollado con Astro Islands. Utiliza Svelte para el reproductor y React para componentes dinámicos.",
    image: "/images/proyecto-3.jpeg",
    live: "https://spotify-clone-with-astro.netlify.app/",
    github: "https://github.com/noldee/spotify-clone",
    stack: ["Astro", "Svelte", "React"],
  },
  {
    title: "La Bruja Store",
    description:
      "E-commerce escalable con backend robusto en Spring Boot para gestión de inventario y procesamiento de pedidos.",
    image: "/images/proyecto-4.jpeg",
    live: "https://labrujastore.com.pe/",
    github: "",
    stack: ["Spring Boot", "Java", "MySQL"],
  },
];
---

<section
  id="proyectos"
  class="py-32 bg-white dark:bg-zinc-900 relative overflow-hidden transition-colors duration-300 border-t-8 border-black dark:border-white"
>
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.03] dark:opacity-[0.05] z-50 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-[length:100%_2px,3px_100%]"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 relative">
    <div id="project-header" class="mb-24 relative">
      <div
        class="inline-block bg-black text-white dark:bg-white dark:text-black px-4 py-2 mb-6 shadow-[8px_8px_0px_0px_#2563eb]"
      >
        <span class="text-xs font-black tracking-[0.5em] uppercase"
          >ARCHIVO_01-04</span
        >
      </div>
      <h3
        class="text-5xl sm:text-7xl md:text-9xl font-black text-black dark:text-white tracking-tighter uppercase italic leading-none"
      >
        Proyectos <span class="text-blue-600 not-italic">!</span>
      </h3>
      <div
        class="h-2 w-full bg-black dark:bg-white mt-4 shadow-[4px_4px_0px_0px_#2563eb]"
      >
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      {
        projects.map((project, index) => (
          <article class="project-card opacity-0 flex flex-col border-4 border-black dark:border-white bg-white dark:bg-zinc-800 shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] dark:shadow-[12px_12px_0px_0px_rgba(37,99,235,1)] hover:shadow-none hover:translate-x-2 hover:translate-y-2 transition-all duration-200 group">
            <div class="bg-black dark:bg-white p-3 flex justify-between items-center border-b-4 border-black dark:border-white">
              <div class="flex items-center gap-3">
                <div class="size-3 bg-red-500 border-2 border-white dark:border-black" />
                <span class="text-[10px] font-black text-white dark:text-black uppercase tracking-widest">
                  PROYECTO_{index + 1}.EXE
                </span>
              </div>
              <span class="text-white dark:text-black font-bold text-xs">
                8-BIT SRC
              </span>
            </div>

            <div class="relative aspect-video overflow-hidden border-b-4 border-black dark:border-white bg-blue-600">
              <img
                src={project.image}
                alt={project.title}
                class="project-img w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-500"
              />
              <div class="absolute inset-0 bg-blue-600/20 mix-blend-multiply group-hover:bg-transparent transition-all" />

              <div class="absolute bottom-4 left-4 flex flex-wrap gap-2 z-20">
                {project.stack.map((tech) => (
                  <span class="bg-yellow-300 text-black border-2 border-black px-2 py-0.5 text-[10px] font-black uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <div class="p-8 flex flex-col flex-1">
              <h3 class="text-4xl font-black text-black dark:text-white mb-4 tracking-tighter uppercase italic group-hover:text-blue-600 transition-colors">
                {project.title}
              </h3>

              <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-tight mb-8 font-bold line-clamp-3">
                {project.description}
              </p>

              <div class="mt-auto flex flex-wrap gap-4">
                <a
                  href={project.live}
                  target="_blank"
                  class="flex-1 text-center bg-blue-600 text-white border-4 border-black px-6 py-3 font-black uppercase text-sm shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-1 active:translate-y-1 transition-all"
                >
                  EJECUTAR_DEMO
                </a>

                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    class="bg-white dark:bg-zinc-700 text-black dark:text-white border-4 border-black dark:border-white px-6 py-3 font-black uppercase text-sm shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,1)] active:shadow-none active:translate-x-1 active:translate-y-1 transition-all"
                  >
                    GITHUB.SH
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Animación de escaneo CRT */
  @keyframes scanline {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100vh);
    }
  }

  /* Glitch sutil para los títulos al hacer hover */
  .project-card:hover h3 {
    animation: glitch 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) both infinite;
  }

  @keyframes glitch {
    0% {
      transform: translate(0);
    }
    20% {
      transform: translate(-2px, 2px);
      text-shadow:
        2px 0 red,
        -2px 0 blue;
    }
    40% {
      transform: translate(-2px, -2px);
    }
    60% {
      transform: translate(2px, 2px);
      text-shadow:
        -2px 0 red,
        2px 0 blue;
    }
    80% {
      transform: translate(2px, -2px);
    }
    100% {
      transform: translate(0);
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("DOMContentLoaded", () => {
    // 1. Cabecera que entra desde arriba como una cortina
    gsap.from("#project-header", {
      y: -100,
      opacity: 0,
      duration: 1,
      ease: "power4.out",
      scrollTrigger: { trigger: "#project-header", start: "top 80%" },
    });

    // 2. Animación de las tarjetas (Se "ensamblan")
    const cards = gsap.utils.toArray(".project-card");

    cards.forEach((card: any, i) => {
      gsap.fromTo(
        card,
        {
          opacity: 0,
          scale: 0.8,
          rotationY: 20,
          y: 100,
        },
        {
          opacity: 1,
          scale: 1,
          rotationY: 0,
          y: 0,
          duration: 0.8,
          ease: "back.out(1.5)",
          delay: i * 0.2, // Stagger manual para más control
          scrollTrigger: {
            trigger: card,
            start: "top 90%",
          },
        },
      );

      // Efecto de inclinación (Tilt) pero estilo Retro (más rígido)
      card.addEventListener("mousemove", (e: MouseEvent) => {
        const { clientX, clientY } = e;
        const { left, top, width, height } = card.getBoundingClientRect();
        const x = (clientX - left) / width - 0.5;
        const y = (clientY - top) / height - 0.5;

        gsap.to(card, {
          rotationY: x * 10,
          rotationX: -y * 10,
          duration: 0.3,
          ease: "power2.out",
        });
      });

      card.addEventListener("mouseleave", () => {
        gsap.to(card, {
          rotationY: 0,
          rotationX: 0,
          duration: 1,
          ease: "elastic.out(1, 0.3)",
        });
      });
    });
  });
</script>
