---
import { FaGithubAlt } from "react-icons/fa";
import { CiLink } from "react-icons/ci";

const projects = [
  {
    title: "Gifs App",
    description:
      "Aplicación de alto rendimiento para la búsqueda y gestión de GIFs en tiempo real. Interfaz fluida, minimalista y totalmente responsiva.",
    image: "/images/proyecto-1.jpeg",
    live: "https://gifs-app-free.netlify.app/",
    github: "https://github.com/noldee/Gifs-App",
    stack: ["React", "Tailwind", "TypeScript"],
  },
  {
    title: "BiblioDigital Core",
    description:
      "Sistema centralizado de gestión para bibliotecas universitarias digitales. Controla el ciclo de vida de préstamos consumidos desde APIs externas, automatiza devoluciones, notificaciones por correo y asegura sesiones de usuario.",
    image: "/images/proyecto-2.jpeg", 
    live: "https://sistemabiblioteca-2yeq.onrender.com/auth/login",
    github: "https://github.com/noldee/SistemaBiblioteca",
    stack: ["Spring Boot", "Thymeleaf", "PostgreSQL", "Supabase", "Tailwind"],
  },
  {
    title: "Spotify Clone",
    description:
      "Clon de Spotify desarrollado con Astro Islands. Utiliza Svelte para el reproductor y React para componentes dinámicos.",
    image: "/images/proyecto-3.jpeg",
    live: "https://spotify-clone-with-astro.netlify.app/",
    github: "https://github.com/noldee/spotify-clone",
    stack: ["Astro", "Svelte", "React"],
  },
  {
    title: "La Bruja Store",
    description:
      "E-commerce escalable con backend robusto en Spring Boot para gestión de inventario y procesamiento de pedidos.",
    image: "/images/proyecto-4.jpeg",
    live: "https://labrujastore.com.pe/",
    github: "",
    stack: ["Spring Boot", "Java", "MySQL", "Render"],
  },
];

const ICONS: Record<string, string> = {
  react: "/images/icons/react.svg",
  tailwind: "/images/icons/tailwind.svg",
  typescript: "/images/icons/typescript.svg",
  "spring boot": "/images/icons/springboot.svg",
  mysql: "/images/icons/mysql.svg",
  astro: "/images/icons/astro.svg",
  svelte: "/images/icons/svelte.svg",
  java: "/images/icons/java.svg",
  render: "/images/icons/render.svg",
  nextjs: "/images/icons/nextjs.svg",
  thymeleaf: "/images/icons/thymeleaf.svg",
  postgresql: "/images/icons/postgresql.svg",
  supabase: "/images/icons/supabase.svg"
};
---

<section id="proyectos" class="py-16 md:py-20 border-t border-[var(--border)] bg-[var(--bg-main)]">
  <div class="max-w-4xl mx-auto px-6">
    
    <!-- Título de Sección Limpio -->
    <div class="mb-10">
      <h2 class="text-lg font-bold text-[var(--text-main)] tracking-tight">
        Proyectos destacados
      </h2>
    </div>

    <!-- Grid de Proyectos Mínimo -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {
        projects.map((project) => (
          <article class="project-card bg-[var(--bg-card)] border border-[var(--border)] rounded-xl p-5 flex flex-col justify-between hover:border-[var(--text-muted)]/40 transition-all duration-300 shadow-sm group">
            <div>
              <!-- Imagen del Proyecto Limpia -->
              <div class="aspect-video overflow-hidden mb-4 bg-[var(--bg-main)] rounded-lg border border-[var(--border)]">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-300 scale-100 group-hover:scale-[1.01]"
                />
              </div>

              <!-- Título del Proyecto -->
              <h3 class="text-sm font-semibold text-[var(--text-main)] mb-1.5 transition-colors group-hover:text-[var(--accent)]">
                {project.title}
              </h3>
              
              <!-- Descripción -->
              <p class="text-[var(--text-muted)] text-xs sm:text-sm leading-relaxed mb-6 font-normal">
                {project.description}
              </p>
            </div>

            <!-- Footer de la Tarjeta (Stack y Enlaces) -->
            <div class="flex items-center justify-between border-t border-[var(--border)] pt-4 mt-auto gap-4">
              <!-- Renderizado de Tecnologías en Cuadrículas Limpias -->
              <div class="flex items-center gap-1.5 flex-wrap">
                {project.stack.map((tech) => {
                  const iconPath = ICONS[tech.toLowerCase()];
                  return (
                    <div
                      class="flex items-center justify-center w-6 h-6 rounded bg-[var(--bg-main)] border border-[var(--border)] p-1.5"
                      title={tech}
                    >
                      {iconPath ? (
                        <img
                          src={iconPath}
                          alt={tech}
                          class="w-full h-full object-contain filter opacity-60 group-hover:opacity-90 transition-opacity"
                        />
                      ) : (
                        <span class="text-[7px] font-medium text-[var(--text-muted)] uppercase">
                          {tech.substring(0, 3)}
                        </span>
                      )}
                    </div>
                  );
                })}
              </div>

              <!-- Enlaces Limpios -->
              <div class="flex items-center gap-2.5 text-[var(--text-muted)]">
                {project.live && (
                  <a
                    href={project.live}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-[var(--text-main)] transition-colors p-1"
                    aria-label="Ver sitio en vivo"
                  >
                    <CiLink className="w-5 h-5" />
                  </a>
                )}

                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-[var(--text-main)] transition-colors p-1"
                    aria-label="Ver repositorio en GitHub"
                  >
                    <FaGithubAlt className="w-4 h-4" />
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray(".project-card").forEach((card: any, i) => {
    gsap.from(card, {
      y: 12,
      opacity: 0,
      duration: 0.4,
      delay: i * 0.1,
      ease: "power2.out",
      scrollTrigger: {
        trigger: card,
        start: "top 85%",
      },
    });
  });
</script>