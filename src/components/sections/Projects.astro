---
import { FaGithubAlt } from "react-icons/fa";
import { CiLink } from "react-icons/ci";

const projects = [
  {
    title: "Gifs App",
    description:
      "Aplicación de alto rendimiento para la búsqueda y gestión de GIFs en tiempo real. Interfaz fluida, minimalista y totalmente responsiva.",
    image: "/images/proyecto-1.jpeg",
    live: "https://gifs-app-free.netlify.app/",
    github: "https://github.com/noldee/Gifs-App",
    stack: ["React", "Tailwind", "TypeScript"],
  },
  {
    title: "BiblioDigital Core",
    description:
      "Sistema centralizado de gestión para bibliotecas universitarias digitales. Controla el ciclo de vida de préstamos consumidos desde APIs externas, automatiza devoluciones, notificaciones por correo y asegura sesiones de usuario.",
    image: "/images/proyecto-2.jpeg", 
    live: "https://sistemabiblioteca-2yeq.onrender.com/auth/login",
    github: "https://github.com/noldee/SistemaBiblioteca",
    stack: ["Spring Boot", "Thymeleaf", "PostgreSQL", "Supabase", "Tailwind"],
  },
  {
    title: "Spotify Clone",
    description:
      "Clon de Spotify desarrollado con Astro Islands. Utiliza Svelte para el reproductor y React para componentes dinámicos.",
    image: "/images/proyecto-3.jpeg",
    live: "https://spotify-clone-with-astro.netlify.app/",
    github: "https://github.com/noldee/spotify-clone",
    stack: ["Astro", "Svelte", "React"],
  },
  {
    title: "La Bruja Store",
    description:
      "E-commerce escalable con backend robusto en Spring Boot para gestión de inventario y procesamiento de pedidos.",
    image: "/images/proyecto-4.jpeg",
    live: "https://labrujastore.com.pe/",
    github: "",
    stack: ["Spring Boot", "Java", "MySQL", "Render"],
  },
];

const upcomingProjects = [
  {
    title: "API Gateway Automator",
    status: "in_design",
    description: "Un middleware ligero en Spring Boot para enrutar y securizar microservicios de forma dinámica."
  },
  {
    title: "Task Scheduler CLI",
    status: "planning",
    description: "Herramienta de consola para automatizar tareas repetitivas de backend mediante comandos programados."
  }
];

// Mapeo actualizado al estilo Bun con tus nuevos iconos
const ICONS: Record<string, string> = {
  react: "/images/icons/react.svg",
  tailwind: "/images/icons/tailwind.svg",
  typescript: "/images/icons/typescript.svg",
  "spring boot": "/images/icons/springboot.svg",
  mysql: "/images/icons/mysql.svg",
  astro: "/images/icons/astro.svg",
  svelte: "/images/icons/svelte.svg",
  java: "/images/icons/java.svg",
  render: "/images/icons/render.svg",
  nextjs: "/images/icons/nextjs.svg",
  thymeleaf: "/images/icons/thymeleaf.svg",
  postgresql: "/images/icons/postgresql.svg",
  supabase: "/images/icons/supabase.svg"
};
---

<section id="proyectos" class="py-20 border-t border-[#222225] bg-[#0b0b0c]">
  <div class="max-w-5xl mx-auto px-4">
    
    <!-- Título de sección estructurado estilo Bun/Deno -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-[#fbebca]">
        [03] proyectos_destacados
      </h2>
      <p class="text-xs font-mono text-[#8c8c93] mt-1">
        repositorios públicos y entornos desplegados
      </p>
    </div>

    <!-- Grid con bordes de separación limpios -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        projects.map((project) => (
          <article class="project-card bg-[#131315] border border-[#222225] rounded-2xl p-6 flex flex-col justify-between hover:border-[#8c8c93]/30 transition-all duration-300 shadow-xl group">
            <div>
              <!-- Imagen Contenedora Redondeada -->
              <div class="aspect-video overflow-hidden mb-5 bg-[#0b0b0c] rounded-xl border border-[#222225]">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-all duration-500 grayscale group-hover:grayscale-0 scale-100 group-hover:scale-[1.02]"
                />
              </div>

              <!-- Título del Proyecto -->
              <h3 class="text-lg font-bold text-[#fbfaf7] mb-2 group-hover:text-[#fbebca] transition-colors">
                {project.title}
              </h3>
              
              <!-- Descripción -->
              <p class="text-[#8c8c93] text-xs sm:text-sm leading-relaxed mb-6 font-normal">
                {project.description}
              </p>
            </div>

            <!-- Footer de la Tarjeta (Stack e Iconos de Link) -->
            <div class="flex items-center justify-between border-t border-[#222225] pt-4 mt-auto gap-4">
              <!-- Renderizado de Tecnologías (Micro-cajas) -->
              <div class="flex items-center gap-1.5 flex-wrap">
                {project.stack.map((tech) => {
                  const iconPath = ICONS[tech.toLowerCase()];
                  return (
                    <div
                      class="flex items-center justify-center w-7 h-7 rounded-lg bg-[#0b0b0c] border border-[#222225] hover:border-[#fbebca]/40 transition-colors p-1.5"
                      title={tech}
                    >
                      {iconPath ? (
                        <img
                          src={iconPath}
                          alt={tech}
                          class="w-full h-full object-contain filter opacity-80 group-hover:opacity-100"
                        />
                      ) : (
                        <span class="text-[8px] font-mono font-bold text-[#8c8c93] uppercase">
                          {tech.substring(0, 3)}
                        </span>
                      )}
                    </div>
                  );
                })}
              </div>

              <!-- Links del Proyecto -->
              <div class="flex items-center gap-3">
                {project.live && (
                  <a
                    href={project.live}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[#8c8c93] hover:text-[#fbebca] transition-colors p-1"
                    aria-label="Demo en vivo"
                  >
                    <CiLink className="w-5 h-5" />
                  </a>
                )}

                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[#8c8c93] hover:text-[#fbfaf7] transition-colors p-1"
                    aria-label="Repositorio de GitHub"
                  >
                    <FaGithubAlt className="w-5 h-5" />
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray(".project-card").forEach((card: any, i) => {
    gsap.from(card, {
      y: 20,
      opacity: 0,
      duration: 0.5,
      delay: i * 0.1,
      ease: "power2.out",
      scrollTrigger: {
        trigger: card,
        start: "top 85%",
      },
    });
  });
</script>