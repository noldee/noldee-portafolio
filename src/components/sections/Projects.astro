---
import { FaGithubAlt } from "react-icons/fa";
import { CiLink } from "react-icons/ci";

const projects = [
  {
    title: "Gifs App",
    description:
      "Aplicación de alto rendimiento para la búsqueda y gestión de GIFs en tiempo real. Interfaz fluida, minimalista y totalmente responsiva.",
    image: "/images/proyecto-1.jpeg",
    live: "https://gifs-app-free.netlify.app/",
    github: "https://github.com/noldee/Gifs-App",
    stack: ["React", "Tailwind", "TypeScript"],
  },
  {
    title: "Modern User Manager",
    description:
      "Full-Stack REST API & Dashboard con arquitectura desacoplada. Backend con Java/Spring y Frontend con React.",
    image: "/images/proyecto-2.jpeg",
    live: "https://modern-user-manager.netlify.app/",
    github: "https://github.com/noldee/modern-user-manager",
    stack: ["React", "Spring Boot", "MySQL", "Nextjs"],
  },
  {
    title: "Spotify Clone",
    description:
      "Clon de Spotify desarrollado con Astro Islands. Utiliza Svelte para el reproductor y React para componentes dinámicos.",
    image: "/images/proyecto-3.jpeg",
    live: "https://spotify-clone-with-astro.netlify.app/",
    github: "https://github.com/noldee/spotify-clone",
    stack: ["Astro", "Svelte", "React"],
  },
  {
    title: "La Bruja Store",
    description:
      "E-commerce escalable con backend robusto en Spring Boot para gestión de inventario y procesamiento de pedidos.",
    image: "/images/proyecto-4.jpeg",
    live: "https://labrujastore.com.pe/",
    github: "",
    stack: ["Spring Boot", "Java", "MySQL", "Render"],
  },
];

// Objeto con las rutas de tus SVGs basado en los nombres de tu stack.
// Las claves están en minúsculas para hacer el emparejamiento insensible a mayúsculas/minúsculas.
const ICONS: Record<string, string> = {
  react: "/images/icons/react.svg",
  tailwind: "/images/icons/tailwind.svg",
  typescript: "/images/icons/typescript.svg",
  "spring boot": "/images/icons/springboot.svg",
  mysql: "/images/icons/mysql.svg",
  astro: "/images/icons/astro.svg",
  svelte: "/images/icons/svelte.svg", // Nota: si usas Svelte, asegúrate de tener el archivo svelte.svg
  java: "/images/icons/java.svg",
  render: "/images/icons/render.svg",
  nextjs: "/images/icons/nextjs.svg"
};
---

<section id="proyectos" class="py-24 border-t border-[var(--border)]">
  <div class="max-w-5xl mx-auto px-6">
    <div class="mb-16">
      <span
        class="text-xs font-mono text-[var(--green)] tracking-widest uppercase mb-4 block"
        >Portafolio</span
      >
      <h2
        class="text-5xl md:text-6xl font-display text-[var(--text)] leading-none"
      >
        Proyectos
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-px bg-[var(--border)]">
      {
        projects.map((project) => (
          <article class="project-card bg-[var(--bg)] group hover:bg-[var(--surface)] transition-colors p-8 flex flex-col justify-between">
            <div>
              <div class="aspect-video overflow-hidden mb-6 bg-[var(--surface-2)] rounded-sm">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-500 grayscale group-hover:grayscale-0"
                />
              </div>

              <h3 class="text-2xl font-display text-[var(--text)] mb-2 group-hover:text-[var(--green)] transition-colors">
                {project.title}
              </h3>
              <p class="text-[var(--text-muted)] text-sm leading-relaxed mb-6">
                {project.description}
              </p>
            </div>

            <div class="flex items-center justify-between border-t border-[var(--border)] pt-5 mt-auto flex-wrap gap-4">
              <div class="flex items-center gap-3">
                {project.stack.map((tech) => {
                  const iconPath = ICONS[tech.toLowerCase()];
                  return (
                    <div
                      class="flex items-center justify-center w-8 h-8 rounded-md bg-[var(--green)]/10 border border-[var(--green)]/20 hover:border-[var(--green)] transition-colors p-1.5"
                      title={tech}
                    >
                      {iconPath ? (
                        <img
                          src={iconPath}
                          alt={tech}
                          class="w-full h-full object-contain filter brightness-125"
                        />
                      ) : (
                        <span class="text-[9px] font-mono text-[var(--green)]">
                          {tech.substring(0, 3)}
                        </span>
                      )}
                    </div>
                  );
                })}
              </div>

              <div class="flex items-center gap-4">
                <a
                  href={project.live}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--text-muted)] hover:text-[var(--green)] flex items-center gap-1.5 transition-colors duration-200"
                  aria-label="Demo del proyecto"
                >
                  <CiLink className="w-5 h-5" />
                </a>

                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--text-muted)] hover:text-[var(--text)] flex items-center gap-1.5 transition-colors duration-200"
                    aria-label="Repositorio de GitHub"
                  >
                    <FaGithubAlt className="w-5 h-5" />
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray(".project-card").forEach((card: any, i) => {
    gsap.from(card, {
      y: 30,
      opacity: 0,
      duration: 0.6,
      delay: i * 0.1,
      ease: "power2.out",
      scrollTrigger: {
        trigger: card,
        start: "top 85%",
      },
    });
  });
</script>
