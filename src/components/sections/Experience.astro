---
// Datos de tu trayectoria profesional
const experience = [
  {
    role: "Desarrollador Frontend (Practicante)",
    company: "LA BRUJA STORE",
    period: "Marzo 2024 — Junio 2024",
    description:
      "Optimización del panel administrativo de e-commerce para la gestión de inventarios y cotizaciones. Implementación de mejoras en accesibilidad y tiempos de carga utilizando Spring Boot y MySQL.",
    stack: ["Spring Boot", "MySQL", "React"],
  },
  {
    role: "Desarrollador Backend (Practicante)",
    company: "WISBAC",
    period: "Septiembre 2023 — Diciembre 2023",
    description:
      "Diseño y desarrollo de servicios para la administración y generación de reportes automatizados utilizando PHP y jQuery. Integración de diversos sistemas para centralizar la información de tablas.",
    stack: ["PHP", "jQuery", "MySQL"],
  },
];
---

<section
  id="experiencia"
  class="py-24 bg-transparent transition-colors duration-300"
>
  <div class="max-w-4xl mx-auto px-6">
    <div class="mb-16">
      <h3
        class="text-5xl font-extrabold tracking-tighter text-black dark:text-white"
      >
        Experiencia
      </h3>
    </div>

    <div
      class="relative border-l-2 border-gray-200 dark:border-white/5 ml-4 md:ml-0"
    >
      {
        experience.map((item) => (
          <div class="exp-item relative pl-10 pb-16 last:pb-0 opacity-0 translate-y-8">
            <div class="absolute -left-[21px] top-0 size-10 bg-white dark:bg-neutral-900 border border-gray-200 dark:border-white/10 rounded-xl flex items-center justify-center z-10 shadow-sm transition-all duration-300 hover:scale-110 hover:border-blue-500">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-gray-500 dark:text-gray-400"
              >
                <rect width="16" height="20" x="4" y="2" rx="2" ry="2" />
                <path d="M9 22v-4h6v4" />
                <path d="M8 6h.01" />
                <path d="M16 6h.01" />
                <path d="M8 10h.01" />
                <path d="M16 10h.01" />
                <path d="M8 14h.01" />
                <path d="M16 14h.01" />
              </svg>
            </div>

            <div class="flex flex-col gap-1 mb-4">
              <h4 class="text-[10px] font-bold text-gray-400 dark:text-neutral-500 uppercase tracking-[0.3em]">
                {item.company}
              </h4>
              <h3 class="text-2xl md:text-3xl font-black text-black dark:text-white tracking-tight leading-none">
                {item.role}
              </h3>
              <div class="flex items-center gap-2 text-blue-600 dark:text-blue-400 text-xs font-bold mt-2 uppercase tracking-widest">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                  <line x1="16" x2="16" y1="2" y2="6" />
                  <line x1="8" x2="8" y1="2" y2="6" />
                  <line x1="3" x2="21" y1="10" y2="10" />
                </svg>
                {item.period}
              </div>
            </div>

            <p class="text-gray-500 dark:text-neutral-400 text-base md:text-lg leading-relaxed max-w-2xl mb-6 font-medium">
              {item.description}
            </p>

            <div class="flex flex-wrap gap-2">
              {item.stack.map((tech) => (
                <span class="px-3 py-1 bg-gray-50 dark:bg-white/[0.03] text-[10px] font-black text-gray-400 dark:text-neutral-500 rounded-lg border border-gray-100 dark:border-white/5 uppercase tracking-widest hover:border-blue-200 dark:hover:border-blue-500/50 hover:text-blue-600 dark:hover:text-blue-400 transition-all cursor-default">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("DOMContentLoaded", () => {
    gsap.to(".exp-item", {
      opacity: 1,
      y: 0,
      duration: 1,
      stagger: 0.3,
      ease: "power4.out",
      scrollTrigger: {
        trigger: "#experiencia",
        start: "top 80%",
      },
    });
  });
</script>
