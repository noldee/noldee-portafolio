---
const experience = [
  {
    role: "Full Stack Developer",
    company: "M&G S.A.C. Servicios Generales",
    period: "Feb 2026 — Jun 2026",
    description:
      "Desarrollo de plataforma web de ventas. Implementación del dashboard administrativo, catálogo interactivo y módulo de gestión de ventas. Arquitectura moderna con autenticación JWT, desplegada en entornos en la nube.",
    stack: ["Next.js", "NestJS", "Prisma", "Supabase", "Tailwind CSS", "shadcn/ui", "Vercel"],
    current: false,
  },
  {
    role: "Desarrollador Frontend",
    company: "LA BRUJA STORE",
    period: "Mar 2024 — Jun 2024",
    description:
      "Optimización del panel administrativo de e-commerce para la gestión de inventarios y cotizaciones. Implementación de mejoras en accesibilidad y tiempos de carga utilizando Spring Boot y MySQL.",
    stack: ["Spring Boot", "MySQL", "React"],
    current: false,
  },
  {
    role: "Desarrollador Backend",
    company: "WISBAC",
    period: "Sep 2023 — Dic 2023",
    description:
      "Diseño y desarrollo de servicios para la administración y generación de reportes automatizados utilizando PHP y jQuery. Integración de diversos sistemas para centralizar la información.",
    stack: ["PHP", "jQuery", "MySQL"],
    current: false,
  },
];
---

<section id="experiencia" class="py-16 md:py-20 border-t border-[var(--border)] bg-[var(--bg-main)]">
  <div class="max-w-4xl mx-auto px-6">
    
    <!-- Título de Sección Limpio -->
    <div class="mb-10">
      <h2 class="text-lg font-bold text-[var(--text-main)] tracking-tight">
        Experiencia laboral
      </h2>
    </div>

    <!-- Lista de Experiencias -->
    <div class="space-y-0">
      {
        experience.map((item) => (
          <div class="exp-card group border-b border-[var(--border)] py-8 grid grid-cols-1 md:grid-cols-[200px_1fr] gap-4 md:gap-8 hover:bg-[var(--bg-card)]/30 transition-colors px-4 -mx-4 rounded-lg">
            
            <!-- Columna Izquierda: Temporalidad y Empresa -->
            <div class="flex flex-col justify-start">
              <span class="text-xs font-semibold text-[var(--text-main)] tracking-tight mb-1">
                {item.company}
              </span>
              
              <div class="flex items-center gap-2">
                {item.current && (
                  <span class="flex h-1.5 w-1.5 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--accent)] opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[var(--accent)]"></span>
                  </span>
                )}
                <span class="text-xs text-[var(--text-muted)]">
                  {item.period}
                </span>
              </div>
            </div>

            <!-- Columna Derecha: Cargo y Detalles Técnicas -->
            <div>
              <h3 class="text-sm font-semibold text-[var(--text-main)] mb-2">
                {item.role}
              </h3>
              <p class="text-[var(--text-muted)] text-sm leading-relaxed mb-4 font-normal">
                {item.description}
              </p>
              
              <!-- Tecnologías en etiquetas sutiles -->
              <div class="flex flex-wrap gap-1.5">
                {item.stack.map((tech) => (
                  <span class="px-2 py-0.5 text-[11px] font-medium text-[var(--text-muted)] border border-[var(--border)] bg-[var(--bg-card)] rounded transition-colors group-hover:text-[var(--text-main)] group-hover:border-[var(--text-muted)]/30">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  gsap.from(".exp-card", {
    y: 12,
    opacity: 0,
    duration: 0.4,
    stagger: 0.12,
    ease: "power2.out",
    scrollTrigger: {
      trigger: "#experiencia",
      start: "top 85%",
    },
  });
</script>