---
const experience = [
  {
    role: "Desarrollador Frontend",
    company: "LA BRUJA STORE",
    period: "Mar 2024 — Jun 2024",
    description:
      "Optimización del panel administrativo de e-commerce para la gestión de inventarios y cotizaciones. Implementación de mejoras en accesibilidad y tiempos de carga utilizando Spring Boot y MySQL.",
    stack: ["Spring Boot", "MySQL", "React"],
  },
  {
    role: "Desarrollador Backend",
    company: "WISBAC",
    period: "Sep 2023 — Dic 2023",
    description:
      "Diseño y desarrollo de servicios para la administración y generación de reportes automatizados utilizando PHP y jQuery. Integración de diversos sistemas para centralizar la información.",
    stack: ["PHP", "jQuery", "MySQL"],
  },
];
---

<section id="experiencia" class="py-24 border-t border-[var(--border)]">
  <div class="max-w-5xl mx-auto px-6">
    <div class="mb-16">
      <span
        class="text-xs font-mono text-[var(--green)] tracking-widest uppercase mb-4 block"
      >
      <h2
        class="text-5xl md:text-6xl font-display text-[var(--text)] leading-none"
      >
        Experiencia
      </h2>
    </div>

    <div class="space-y-0">
      {
        experience.map((item, i) => (
          <div class="exp-card group border-t border-[var(--border)] py-10 grid grid-cols-1 md:grid-cols-[200px_1fr] gap-6 md:gap-16 hover:bg-[var(--surface)] transition-colors px-4 -mx-4">
            <div>
              <p class="text-xs font-mono text-[var(--green)] uppercase tracking-widest mb-1">
                {item.company}
              </p>
              <p class="text-sm text-[var(--text-muted)]">{item.period}</p>
            </div>

            <div>
              <h3 class="text-xl font-display text-[var(--text)] mb-3 leading-tight">
                {item.role}
              </h3>
              <p class="text-[var(--text-muted)] text-base leading-relaxed mb-5">
                {item.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {item.stack.map((tech) => (
                  <span class="px-2.5 py-1 text-xs font-mono text-[var(--text-muted)] border border-[var(--border)] bg-[var(--surface-2)]">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))
      }
      <!-- Línea final -->
      <div class="border-t border-[var(--border)]"></div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  gsap.from(".exp-card", {
    y: 20,
    opacity: 0,
    duration: 0.5,
    stagger: 0.2,
    ease: "power2.out",
    scrollTrigger: {
      trigger: "#experiencia",
      start: "top 75%",
    },
  });
</script>
