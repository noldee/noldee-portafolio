---
// Contacto.astro
---

<section id="contacto" class="py-24 bg-white border-t border-gray-100">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <div id="contact-content" class="opacity-0 translate-y-8">
      <h4
        class="text-3xl md:text-5xl font-extrabold text-black tracking-tighter mb-4"
      >
        Envíame un mail
      </h4>

      <p class="text-gray-500 text-lg md:text-xl mb-12 font-medium">
        Respondo más rápido si hay un repo de por medio. <br />
        <span class="text-blue-600 italic"
          >Colaborar con proyectos es mi gusto ;)</span
        >
      </p>

      <a
        href="mailto:socamezareswalter@gmail.com"
        class="inline-block text-xl md:text-4xl font-black text-black hover:text-blue-600 transition-colors tracking-tighter break-all"
      >
        socamezareswalter@gmail.com
      </a>
    </div>

    <footer
      class="mt-24 pt-8 border-t border-gray-50 flex flex-col md:flex-row justify-between items-center gap-6"
    >
      <p class="text-gray-400 text-[10px] uppercase tracking-[0.2em] font-bold">
        © 2026 — Walter Soca
      </p>

      <nav class="flex gap-6">
        <a
          href="https://github.com/noldee"
          class="text-gray-400 hover:text-black transition-colors text-xs font-bold uppercase tracking-widest"
          >GitHub</a
        >
        <a
          href="https://www.linkedin.com/in/walter-soca-mezares-5b158b3b0/"
          class="text-gray-400 hover:text-blue-600 transition-colors text-xs font-bold uppercase tracking-widest"
          >LinkedIn</a
        >
      </nav>
    </footer>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("DOMContentLoaded", () => {
    gsap.to("#contact-content", {
      opacity: 1,
      y: 0,
      duration: 1,
      ease: "power4.out",
      scrollTrigger: {
        trigger: "#contacto",
        start: "top 85%",
      },
    });
  });
</script>
