---
import ButtonDownload from "../ui/ButtonDownload.astro";
import { ModeToggle } from "../ui/ModeToggle";
import NavLink from "../ui/NavLink.astro";
---

<header
  class="sticky top-0 z-[100] w-full border-b border-gray-100 dark:border-white/10 bg-white/80 dark:bg-black/80 backdrop-blur-md"
>
  <div class="max-w-6xl mx-auto flex justify-between items-center py-4 px-6">
    <a href="/" class="flex items-center gap-2 group z-[120]">
      <h2
        class="text-xl font-bold tracking-tighter text-black dark:text-white uppercase"
      >
        Noldee<span class="text-blue-600">
      </h2>
    </a>

    <div class="flex items-center gap-6">
      <nav
        class="hidden md:flex items-center gap-x-8 text-sm font-medium text-gray-500 dark:text-gray-400"
      >
        <NavLink
          className="hover:text-blue-600 transition-colors"
          href="/"
          title="Inicio"
        />
        <NavLink
          className="hover:text-blue-600 transition-colors"
          href="#experiencia"
          title="Experiencia"
        />
        <NavLink
          className="hover:text-blue-600 transition-colors"
          href="#proyectos"
          title="Proyectos"
        />
        <NavLink
          className="hover:text-blue-600 transition-colors"
          href="/blog"
          title="Blog"
        />
        <NavLink
          className="hover:text-blue-600 transition-colors"
          href="#contacto"
          title="Contacto"
        />
      </nav>

      <div class="hidden md:block">
        <ButtonDownload />
      </div>
      <ModeToggle client:load />

      <button
        id="menu-toggle"
        aria-label="Menu"
        class="relative z-[120] md:hidden flex flex-col justify-center items-end size-10 gap-[6px] group"
      >
        <span
          class="line w-7 h-[2px] bg-black dark:bg-white rounded-full transition-all duration-300"
        ></span>
        <span
          class="line w-5 h-[2px] bg-black dark:bg-white rounded-full transition-all duration-300 group-hover:w-7"
        ></span>
        <span
          class="line w-7 h-[2px] bg-black dark:bg-white rounded-full transition-all duration-300"
        ></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="fixed inset-0 w-full h-screen bg-white dark:bg-black z-[110] flex flex-col items-center justify-center opacity-0 pointer-events-none"
  >
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] dark:bg-[radial-gradient(#ffffff10_1px,transparent_1px)] [background-size:20px_20px] opacity-40"
    >
    </div>

    <nav class="flex flex-col items-center gap-y-8 w-full px-10">
      {
        ["Inicio", "Experiencia", "Proyectos", "Blog", "Contacto"].map(
          (text) => (
            <div class="overflow-hidden">
              <a
                href={
                  text === "Inicio"
                    ? "/"
                    : text === "Blog"
                      ? "/blog"
                      : `#${text.toLowerCase()}`
                }
                class="mobile-link block text-5xl font-black text-black dark:text-white tracking-tighter hover:text-blue-600 transition-colors uppercase italic pr-4"
              >
                {text}
              </a>
            </div>
          ),
        )
      }

      <div class="mobile-link-btn mt-8 opacity-0 translate-y-4">
        <ButtonDownload />
      </div>
    </nav>

    <div class="absolute bottom-12 flex flex-col items-center gap-2">
      <span class="text-xs font-bold text-gray-400 uppercase tracking-widest"
        >Connect with me</span
      >
      <div class="h-px w-8 bg-gray-200 dark:bg-white/20"></div>
    </div>
  </div>
</header>

<script>
  import { gsap } from "gsap";

  const menuToggle = document.querySelector("#menu-toggle");
  const mobileMenu = document.querySelector("#mobile-menu");
  const lines = document.querySelectorAll(".line");
  const mobileLinks = document.querySelectorAll(".mobile-link");
  const mobileBtn = document.querySelector(".mobile-link-btn");

  let isOpen = false;

  const menuTl = gsap.timeline({ paused: true });

  menuTl
    .to(mobileMenu, {
      opacity: 1,
      pointerEvents: "auto",
      duration: 0.5,
      ease: "power4.inOut",
    })
    .from(
      mobileLinks,
      {
        y: 100,
        stagger: 0.1,
        duration: 0.8,
        ease: "power4.out",
      },
      "-=0.2",
    )
    .to(
      mobileBtn,
      {
        opacity: 1,
        y: 0,
        duration: 0.4,
      },
      "-=0.4",
    );

  function toggleMenu() {
    isOpen = !isOpen;

    if (isOpen) {
      // Bloqueo de salto de scroll
      const scrollBarWidth =
        window.innerWidth - document.documentElement.clientWidth;
      document.body.style.paddingRight = `${scrollBarWidth}px`;
      document.body.style.overflow = "hidden";

      gsap.to(lines[0], {
        y: 8,
        rotation: 45,
        duration: 0.4,
        ease: "power4.inOut",
      });
      gsap.to(lines[1], { width: 0, opacity: 0, duration: 0.2 });
      gsap.to(lines[2], {
        y: -8,
        rotation: -45,
        duration: 0.4,
        ease: "power4.inOut",
      });

      menuTl.play();
    } else {
      document.body.style.overflow = "auto";
      document.body.style.paddingRight = "";

      gsap.to(lines[0], { y: 0, rotation: 0, duration: 0.4 });
      gsap.to(lines[1], { width: "1.25rem", opacity: 1, duration: 0.3 });
      gsap.to(lines[2], { y: 0, rotation: 0, duration: 0.4 });

      menuTl.reverse();
    }
  }

  menuToggle?.addEventListener("click", toggleMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener("click", toggleMenu);
  });
</script>
