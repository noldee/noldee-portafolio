---
import ExternalLink from "../icons/ExternalLink.astro";
import { ModeToggle } from "../ui/ModeToggle";
import NavLink from "../ui/NavLink.astro";
---

<header
  class="fixed top-0 left-0 right-0 z-[100] border-b border-[var(--border)] bg-[var(--bg)]/90 backdrop-blur-sm"
>
  <div
    class="max-w-5xl mx-auto flex justify-between items-center h-[72px] px-6"
  >
    <a
      href="/"
      class="text-[var(--green)] font-display text-lg tracking-tight hover:opacity-80 transition-opacity"
    >
      Euronymous
    </a>

    <div class="flex items-center gap-8">
      <nav
        class="hidden md:flex items-center gap-x-8 text-sm font-medium text-[var(--text-muted)]"
      >
        <NavLink
          className="hover:text-[var(--text)] transition-colors"
          href="/"
          title="Inicio"
        />
        <NavLink
          className="hover:text-[var(--text)] transition-colors"
          href="#experiencia"
          title="Experiencia"
        />
        <NavLink
          className="hover:text-[var(--text)] transition-colors"
          href="#proyectos"
          title="Proyectos"
        />
        <NavLink
          className="hover:text-[var(--text)] transition-colors"
          href="/blog"
          title="Blog"
        />
        <NavLink
          className="hover:text-[var(--text)] transition-colors"
          href="#contacto"
          title="Contacto"
        />
      </nav>

      <div class="flex items-center gap-4">
        <a
          href="CV.pdf"
          download
          class="hidden md:flex text-sm font-semibold text-[var(--green)] border border-[var(--green)] px-5 py-2 hover:bg-[var(--green)] hover:text-black transition-all rounded-sm items-center"
        >
          Descargar CV
        </a>

        <button
          id="menu-toggle"
          aria-label="Abrir menú"
          class="md:hidden flex flex-col gap-1.5 p-2 relative"
        >
          <span class="h-px w-6 bg-[var(--text)] block" id="bar-1"></span>
          <span class="h-px w-6 bg-[var(--text)] block" id="bar-2"></span>
          <span class="h-px w-4 bg-[var(--text)] block" id="bar-3"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<!--
  Mobile menu: FUERA del <header> y con z-[999] para estar encima de todo.
  Fondo #111111 forzado con style inline para evitar conflictos con Tailwind.
-->
<div
  id="mobile-menu"
  class="hidden fixed inset-0 z-[999] flex-col"
  style="background-color: #111111;"
>
  <!-- Top bar -->
  <div
    class="flex items-center justify-between h-[72px] px-6 border-b border-[#262626] flex-shrink-0"
  >
    <span class="text-[var(--green)] font-display text-lg tracking-tight"
      >Euronymous</span
    >
    <button
      id="close-menu"
      aria-label="Cerrar menú"
      class="text-[#737373] hover:text-white transition-colors p-2"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Nav links -->
  <nav class="flex flex-col px-6 mt-6 flex-1">
    {
      [
        { text: "Inicio", href: "/" },
        { text: "Experiencia", href: "#experiencia" },
        { text: "Proyectos", href: "#proyectos" },
        { text: "Blog", href: "/blog" },
        { text: "Contacto", href: "#contacto" },
      ].map((item) => (
        <a
          href={item.href}
          class="mobile-link text-4xl font-display text-white hover:text-[var(--green)] transition-colors tracking-tight py-4 border-b border-[#1f1f1f]"
        >
          {item.text}
        </a>
      ))
    }
  </nav>

  <!-- Botón CV al fondo -->
  <div class="px-6 pb-10 pt-6 flex-shrink-0">
    <a
      href="CV.pdf"
      download
      class="mobile-link block w-full text-center text-base font-semibold text-[var(--green)] border border-[var(--green)] py-4 hover:bg-[var(--green)] hover:text-black transition-all"
    >
      Descargar CV
    </a>
  </div>
</div>

<div class="h-[72px]"></div>

<script>
  const menuToggle = document.querySelector(
    "#menu-toggle",
  ) as HTMLButtonElement;
  const closeMenu = document.querySelector("#close-menu") as HTMLButtonElement;
  const mobileMenu = document.querySelector("#mobile-menu") as HTMLDivElement;
  const mobileLinks = document.querySelectorAll(".mobile-link");

  let isOpen = false;

  function openMenu() {
    isOpen = true;
    mobileMenu.classList.remove("hidden");
    mobileMenu.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeMenuFn() {
    isOpen = false;
    mobileMenu.classList.add("hidden");
    mobileMenu.classList.remove("flex");
    document.body.style.overflow = "";
  }

  menuToggle?.addEventListener("click", openMenu);
  closeMenu?.addEventListener("click", closeMenuFn);
  mobileLinks.forEach((link) => link.addEventListener("click", closeMenuFn));
</script>
