---
import ExternalLink from "../icons/ExternalLink.astro";
import { ModeToggle } from "../ui/ModeToggle";
import NavLink from "../ui/NavLink.astro";
---

<header
  class="relative w-full border-b-4 border-black bg-white dark:bg-zinc-900 dark:border-white z-[100]"
>
  <div class="max-w-6xl mx-auto flex justify-between items-center py-4 px-6">
    <a
      href="/"
      class="z-[120] border-2 border-black bg-blue-600 px-3 py-1 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
    >
      <h2
        class="text-xl font-black tracking-tighter text-white uppercase italic"
      >
        Noldee
      </h2>
    </a>

    <div class="flex items-center gap-4 md:gap-8">
      <nav
        class="hidden md:flex items-center gap-x-6 text-sm font-bold text-black dark:text-white uppercase"
      >
        <NavLink
          className="hover:underline decoration-4 decoration-blue-600 underline-offset-4"
          href="/"
          title="Inicio"
        />
        <NavLink
          className="hover:underline decoration-4 decoration-blue-600 underline-offset-4"
          href="#experiencia"
          title="Experiencia"
        />
        <NavLink
          className="hover:underline decoration-4 decoration-blue-600 underline-offset-4"
          href="#proyectos"
          title="Proyectos"
        />
        <NavLink
          className="hover:underline decoration-4 decoration-blue-600 underline-offset-4"
          href="/blog"
          title="Blog"
        />
        <NavLink
          className="hover:underline decoration-4 decoration-blue-600 underline-offset-4"
          href="#contacto"
          title="Contacto"
        />
      </nav>

      <div class="flex items-center gap-4">
        <div class="hidden md:block">
          <ExternalLink
            className="border-2 border-black bg-yellow-400 px-4 py-2 font-bold uppercase shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] transition-all inline-block"
            href="/CV.pdf"
            download="CV-WALTER-SOCA"
          >
            Descargar CV
          </ExternalLink>
        </div>

        <div class="retro-mode-toggle">
          <ModeToggle client:load />
        </div>

        <button
          id="menu-toggle"
          aria-label="Menu"
          class="md:hidden border-2 border-black p-2 bg-white shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-[1px] active:translate-y-[1px]"
        >
          <div class="flex flex-col gap-1 w-6">
            <span class="h-1 w-full bg-black"></span>
            <span class="h-1 w-full bg-black"></span>
            <span class="h-1 w-full bg-black"></span>
          </div>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="fixed inset-4 border-4 border-black bg-white dark:bg-zinc-900 z-[150] flex flex-col items-center justify-center hidden opacity-0 shadow-[10px_10px_0px_0px_rgba(0,0,0,1)]"
  >
    <div
      class="absolute top-0 left-0 w-full bg-black text-white px-4 py-1 flex justify-between items-center"
    >
      <span class="font-bold text-xs uppercase tracking-widest italic"
        >Noldee_Menu.sh</span
      >
      <button
        id="close-menu"
        class="bg-red-500 border-2 border-white size-6 flex items-center justify-center text-xs font-bold hover:bg-red-600"
        >X</button
      >
    </div>

    <nav class="flex flex-col items-center gap-y-4 w-full px-8">
      {
        ["Inicio", "Experiencia", "Proyectos", "Blog", "Contacto"].map(
          (text) => (
            <a
              href={
                text === "Inicio"
                  ? "/"
                  : text === "Blog"
                    ? "/blog"
                    : `#${text.toLowerCase()}`
              }
              class="mobile-link text-3xl font-black text-black dark:text-white uppercase hover:bg-blue-600 hover:text-white px-4 py-2 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all w-full text-center bg-white dark:bg-zinc-800"
            >
              {text}
            </a>
          ),
        )
      }

      <a
        href="CV.pdf"
        download
        class="mobile-link mt-4 flex items-center justify-center gap-3 text-3xl font-black text-black uppercase bg-green-400 hover:bg-yellow-300 px-4 py-3 border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-1 active:translate-y-1 transition-all w-full text-center"
      >
        <svg
          class="size-8 animate-bounce"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="3"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
          ></path>
        </svg>
        Descargar_CV
      </a>
    </nav>
  </div>
</header>

<style is:global>
  /* ESTILOS PARA ARREGLAR EL DROPDOWN DEL MODO OSCURO */

  /* Forzamos el contenedor del menú (Radix/Shadcn suele usar estos roles) */
  [role="menu"],
  [data-radix-menu-content] {
    background-color: white !important;
    border: 3px solid black !important;
    border-radius: 0px !important;
    box-shadow: 6px 6px 0px 0px rgba(0, 0, 0, 1) !important;
    padding: 4px !important;
    min-width: 140px !important;
  }

  .dark [role="menu"],
  .dark [data-radix-menu-content] {
    background-color: #18181b !important; /* zinc-900 */
    border-color: white !important;
    box-shadow: 6px 6px 0px 0px rgba(255, 255, 255, 1) !important;
  }

  /* Items del menú */
  [role="menuitem"] {
    font-weight: 800 !important;
    text-transform: uppercase !important;
    font-size: 12px !important;
    border-radius: 0px !important;
    padding: 8px !important;
    cursor: pointer !important;
  }

  [role="menuitem"]:hover {
    background-color: #2563eb !important; /* blue-600 */
    color: white !important;
  }

  /* El botón que activa el menú */
  .retro-mode-toggle button {
    border: 2px solid black !important;
    border-radius: 0px !important;
    box-shadow: 3px 3px 0px 0px rgba(0, 0, 0, 1) !important;
    transition: all 0.1s !important;
    background: white !important;
  }

  .dark .retro-mode-toggle button {
    background: #18181b !important;
    border-color: white !important;
    box-shadow: 3px 3px 0px 0px rgba(255, 255, 255, 1) !important;
    color: white !important;
  }

  .retro-mode-toggle button:active {
    box-shadow: none !important;
    transform: translate(2px, 2px) !important;
  }
</style>

<script>
  import { gsap } from "gsap";

  const menuToggle = document.querySelector("#menu-toggle");
  const closeMenu = document.querySelector("#close-menu");
  const mobileMenu = document.querySelector("#mobile-menu") as HTMLDivElement;
  const mobileLinks = document.querySelectorAll(".mobile-link");

  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    if (isOpen) {
      mobileMenu.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      gsap.to(mobileMenu, {
        opacity: 1,
        scale: 1,
        duration: 0.3,
        ease: "back.out(1.2)",
      });
    } else {
      document.body.style.overflow = "auto";
      gsap.to(mobileMenu, {
        opacity: 0,
        scale: 0.9,
        duration: 0.2,
        onComplete: () => mobileMenu.classList.add("hidden"),
      });
    }
  }

  menuToggle?.addEventListener("click", toggleMenu);
  closeMenu?.addEventListener("click", toggleMenu);
  mobileLinks.forEach((link) => link.addEventListener("click", toggleMenu));
</script>
