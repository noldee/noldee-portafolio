---
const projects = [
  {
    title: "Gifs App",
    description: "Aplicación de alto rendimiento para la búsqueda y gestión de GIFs en tiempo real. Interfaz fluida, minimalista y totalmente responsiva.",
    image: "/images/proyecto-1.jpeg",
    live: "https://gifs-app-free.netlify.app/",
    github: "https://github.com/noldee/Gifs-App",
    stack: ["React", "Tailwind", "TypeScript"],
  },
  {
    title: "Modern User Manager",
    description: "Full-Stack REST API & Dashboard con arquitectura desacoplada. Backend con Java/Spring y Frontend con React.",
    image: "/images/proyecto-2.jpeg",
    live: "https://modern-user-manager.netlify.app/",
    github: "https://github.com/noldee/modern-user-manager",
    stack: ["React", "Spring Boot", "MySQL"],
  },
  {
    title: "Spotify Clone",
    description: "Clon de Spotify desarrollado con Astro Islands. Utiliza Svelte para el reproductor y React para componentes dinámicos.",
    image: "/images/proyecto-3.jpeg",
    live: "https://spotify-clone-with-astro.netlify.app/",
    github: "https://github.com/noldee/spotify-clone",
    stack: ["Astro", "Svelte", "React"],
  },
  {
    title: "La Bruja Store",
    description: "E-commerce escalable con backend robusto en Spring Boot para gestión de inventario y procesamiento de pedidos.",
    image: "/images/proyecto-4.jpeg",
    live: "https://labrujastore.com.pe/",
    github: "", // Sin GitHub
    stack: ["Spring Boot", "Java", "MySQL"],
  },
];
---

<section id="proyectos" class="py-24 bg-white relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div
      id="project-header"
      class="flex flex-col mb-16 opacity-0 translate-y-10"
    >
      <span
        class="text-blue-600 text-xs font-bold tracking-[0.3em] uppercase mb-4"
        >Selected Works</span
      >
      <h3 class="text-5xl font-extrabold text-black tracking-tighter">
        Proyectos <span class="text-gray-300">/</span> 01-04
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      {
        projects.map((project, index) => (
          <article class="project-card opacity-0 flex flex-col rounded-[2.5rem] border border-gray-100 bg-white p-4 transition-colors duration-500 hover:border-blue-100 group">
            
            <div
              class="project-image-wrapper relative aspect-[16/10] rounded-[2rem] overflow-visible mb-6"
              style="perspective: 1000px;"
            >
              <div class="project-image-container relative h-full w-full rounded-[1.5rem] overflow-hidden bg-gray-100 shadow-sm transition-transform duration-500">
                <img
                  src={project.image}
                  alt={project.title}
                  class="project-img h-full w-full object-cover scale-110 will-change-transform"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
              </div>
            </div>

            <div class="px-4 flex flex-col flex-1">
              <div class="flex flex-wrap gap-2 mb-4">
                {project.stack.map((tech) => (
                  <span class="px-3 py-1 rounded-full bg-blue-50/50 border border-blue-100/50 text-[10px] font-bold text-blue-600 uppercase tracking-widest">
                    {tech}
                  </span>
                ))}
              </div>

              <h3 class="text-3xl font-bold text-black mb-3 tracking-tight">
                {project.title}
              </h3>

              <p class="text-gray-500 text-sm leading-relaxed mb-8 line-clamp-3">
                {project.description}
              </p>

              <div class="mt-auto flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <a
                    href={project.live}
                    target="_blank"
                    class="flex items-center gap-2 bg-black text-white px-5 py-2.5 rounded-xl text-xs font-bold hover:bg-blue-600 transition-all shadow-lg shadow-gray-200"
                  >
                    Live Demo
                    <svg
                      class="size-3"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      viewBox="0 0 24 24"
                    >
                      <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                  </a>

                  {project.github && (
                    <a
                      href={project.github}
                      target="_blank"
                      class="flex items-center gap-2 bg-gray-100 text-black px-5 py-2.5 rounded-xl text-xs font-bold hover:bg-gray-200 transition-all"
                    >
                      GitHub
                      <svg
                        class="size-4"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                      </svg>
                    </a>
                  )}
                </div>
                <span class="text-gray-100 font-black text-4xl italic group-hover:text-blue-50 transition-colors">
                  0{index + 1}
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("DOMContentLoaded", () => {
    // 1. Entrada de cabecera
    gsap.to("#project-header", {
      opacity: 1,
      y: 0,
      duration: 1.2,
      ease: "expo.out",
      scrollTrigger: { trigger: "#project-header", start: "top 90%" },
    });

    const cards = gsap.utils.toArray(".project-card");

    cards.forEach((card: any) => {
      // 2. Animación de entrada de la tarjeta
      gsap.fromTo(
        card,
        { opacity: 0, y: 60 },
        {
          opacity: 1,
          y: 0,
          duration: 1,
          ease: "power4.out",
          scrollTrigger: { trigger: card, start: "top 85%" },
        },
      );

      // 3. EFECTO 3D SOLO EN LA IMAGEN
      const container = card.querySelector(".project-image-container");
      const img = card.querySelector(".project-img");

      card.addEventListener("mousemove", (e: MouseEvent) => {
        const { clientX, clientY } = e;
        const { left, top, width, height } = container.getBoundingClientRect();

        const xPercent = (clientX - left) / width - 0.5;
        const yPercent = (clientY - top) / height - 0.5;

        // El contenedor rota sutilmente
        gsap.to(container, {
          rotationY: xPercent * 12,
          rotationX: -yPercent * 12,
          duration: 0.5,
          ease: "power2.out",
        });

        // La imagen se desplaza en sentido contrario para profundidad
        gsap.to(img, {
          x: xPercent * -15,
          y: yPercent * -15,
          scale: 1.2, // Mantengo el scale para el efecto 'pop'
          duration: 0.5,
          ease: "power2.out",
        });
      });

      card.addEventListener("mouseleave", () => {
        gsap.to(container, {
          rotationY: 0,
          rotationX: 0,
          duration: 1,
          ease: "elastic.out(1, 0.4)",
        });
        gsap.to(img, {
          x: 0,
          y: 0,
          scale: 1.1, // Vuelve al scale base definido en la img clase
          duration: 1,
          ease: "elastic.out(1, 0.4)",
        });
      });
    });
  });
</script>

<style>
  .project-card {
    will-change: transform, border-color;
  }
  .project-image-container {
    transform-style: preserve-3d;
    will-change: transform;
  }
  .project-img {
    will-change: transform;
  }
</style>