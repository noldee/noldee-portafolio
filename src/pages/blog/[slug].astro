---
import Layout from "@/layout/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} | Walter Soca`}>
  <main class="min-h-screen py-24">
    <div class="max-w-3xl mx-auto px-6">
      <!-- Breadcrumb -->
      <nav class="mb-16">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-xs font-mono text-[var(--text-muted)] hover:text-[var(--green)] transition-colors group"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-hover:-translate-x-1 transition-transform"
          >
            <path d="M19 12H5M12 5l-7 7 7 7"></path>
          </svg>
          blog
        </a>
        <span class="text-[var(--text-dim)] font-mono text-xs mx-2">/</span>
        <span class="text-xs font-mono text-[var(--text-muted)] truncate"
          >{post.data.title}</span
        >
      </nav>

      <!-- Header del post -->
      <header class="mb-12 pb-12 border-b border-[var(--border)]">
        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mb-6">
          {
            post.data.tags.map((tag: string) => (
              <span class="text-[10px] font-mono text-[var(--green)] border border-[var(--green)] px-2 py-0.5">
                #{tag}
              </span>
            ))
          }
        </div>

        <!-- Título -->
        <h1
          class="text-4xl md:text-6xl font-display text-[var(--text)] leading-none tracking-tight mb-8"
        >
          {post.data.title}
        </h1>

        <!-- Meta -->
        <div
          class="flex items-center gap-6 text-xs font-mono text-[var(--text-muted)]"
        >
          <div class="flex items-center gap-2">
            <span
              class="w-1.5 h-1.5 rounded-full bg-[var(--green)] animate-pulse"
            ></span>
            <time
              >{
                post.data.pubDate.toLocaleDateString("es-ES", {
                  dateStyle: "full",
                })
              }</time
            >
          </div>
          <span>Walter Soca</span>
        </div>
      </header>

      <!-- Imagen destacada -->
      <div
        class="aspect-video overflow-hidden mb-12 border border-[var(--border)] bg-[var(--surface-2)]"
      >
        <img
          src={post.data.image}
          alt={post.data.title}
          class="w-full h-full object-cover opacity-80"
        />
      </div>

      <!-- Contenido -->
      <article class="prose-blog">
        <Content />
      </article>

      <!-- Footer del post -->
      <footer
        class="mt-20 pt-10 border-t border-[var(--border)] flex items-center justify-between flex-wrap gap-4"
      >
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-mono text-[var(--text-muted)] hover:text-[var(--green)] transition-colors group"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-hover:-translate-x-1 transition-transform"
          >
            <path d="M19 12H5M12 5l-7 7 7 7"></path>
          </svg>
          todos los posts
        </a>
        <span class="text-xs font-mono text-[var(--text-dim)]"
          >// fin del artículo</span
        >
      </footer>
    </div>
  </main>
</Layout>

<style is:global>
  .prose-blog {
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-muted);
  }

  .prose-blog p {
    margin-bottom: 1.5rem;
    color: var(--text-muted);
  }

  /* Headings */
  .prose-blog h2,
  .prose-blog h3,
  .prose-blog h4 {
    font-family: "Archivo Black", sans-serif;
    color: var(--text);
    letter-spacing: -0.03em;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .prose-blog h2 {
    font-size: 1.75rem;
    border-left: 2px solid var(--green);
    padding-left: 1rem;
  }

  .prose-blog h3 {
    font-size: 1.25rem;
    color: var(--text);
  }

  /* Links */
  .prose-blog a {
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose-blog a:hover {
    opacity: 0.8;
  }

  /* Code inline */
  .prose-blog :not(pre) > code {
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 0.875em;
    background-color: var(--surface-2);
    color: var(--green);
    border: 1px solid var(--border);
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
  }

  /* Code blocks */
  .prose-blog pre {
    background-color: var(--surface) !important;
    border: 1px solid var(--border);
    border-left: 2px solid var(--green);
    padding: 1.5rem !important;
    overflow-x: auto;
    margin: 2rem 0;
    border-radius: 0;
  }

  .prose-blog pre code {
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 0.875rem;
    background: none;
    border: none;
    padding: 0;
    color: var(--text);
  }

  /* Blockquote */
  .prose-blog blockquote {
    border-left: 2px solid var(--green);
    padding-left: 1.25rem;
    margin: 2rem 0;
    color: var(--text-muted);
    font-style: italic;
  }

  /* Listas */
  .prose-blog ul,
  .prose-blog ol {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
  }

  .prose-blog ul li {
    list-style-type: none;
    position: relative;
    padding-left: 1rem;
    margin-bottom: 0.5rem;
  }

  .prose-blog ul li::before {
    content: "—";
    position: absolute;
    left: -0.75rem;
    color: var(--green);
    font-size: 0.75rem;
  }

  .prose-blog ol li {
    margin-bottom: 0.5rem;
  }

  /* Separador horizontal */
  .prose-blog hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  /* Imágenes dentro del contenido */
  .prose-blog img {
    width: 100%;
    border: 1px solid var(--border);
    margin: 2rem 0;
  }

  /* Tabla */
  .prose-blog table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9rem;
  }

  .prose-blog th {
    text-align: left;
    font-family: "Archivo Black", sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text);
    border-bottom: 1px solid var(--green);
    padding: 0.75rem 1rem;
  }

  .prose-blog td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
  }

  .prose-blog tr:last-child td {
    border-bottom: none;
  }
</style>
