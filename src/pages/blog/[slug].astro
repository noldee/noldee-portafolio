---
import Layout from "@/layout/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title}>
  <main
    class="py-24 bg-zinc-50 dark:bg-zinc-950 min-h-screen relative overflow-hidden"
  >
    <div
      class="absolute inset-0 opacity-[0.05] pointer-events-none bg-[radial-gradient(#000_1px,transparent_1px)] [background-size:20px_20px]"
    >
    </div>

    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <nav class="mb-16">
        <a
          href="/blog"
          class="group inline-flex items-center gap-3 bg-white dark:bg-zinc-900 border-4 border-black dark:border-white px-5 py-2 font-black uppercase tracking-tighter shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(37,99,235,1)] hover:shadow-none hover:translate-x-1 hover:translate-y-1 transition-all"
        >
          <svg
            class="size-5 transition-transform group-hover:-translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="3"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          REGRESAR_AL_SISTEMA
        </a>
      </nav>

      <article
        class="relative bg-white dark:bg-zinc-900 border-4 border-black dark:border-white shadow-[16px_16px_0px_0px_rgba(0,0,0,1)] dark:shadow-[16px_16px_0px_0px_rgba(37,99,235,1)] overflow-hidden"
      >
        <div
          class="bg-black dark:bg-white p-3 flex justify-between items-center border-b-4 border-black dark:border-white"
        >
          <div class="flex gap-2">
            <div class="size-3 bg-red-500 border-2 border-black"></div>
            <div class="size-3 bg-yellow-400 border-2 border-black"></div>
            <div class="size-3 bg-green-500 border-2 border-black"></div>
          </div>
          <span
            class="text-[10px] font-black text-white dark:text-black uppercase tracking-[0.4em]"
            >READING_MODE: ON</span
          >
        </div>

        <header
          class="p-8 md:p-12 border-b-4 border-black dark:border-white bg-blue-50/30 dark:bg-blue-900/10"
        >
          <div class="flex flex-wrap gap-2 mb-6">
            {
              post.data.tags.map((tag) => (
                <span class="bg-yellow-300 text-black border-2 border-black px-3 py-1 text-[10px] font-black uppercase tracking-widest">
                  #{tag}
                </span>
              ))
            }
          </div>

          <h1
            class="text-4xl md:text-6xl font-black text-black dark:text-white uppercase italic tracking-tighter leading-none mb-8"
          >
            {post.data.title}
          </h1>

          <div
            class="flex items-center gap-6 font-mono text-[11px] font-bold uppercase text-zinc-500 dark:text-zinc-400"
          >
            <div class="flex items-center gap-2">
              <span class="size-2 bg-blue-600 animate-pulse"></span>
              <time
                >{
                  post.data.pubDate.toLocaleDateString("es-ES", {
                    dateStyle: "full",
                  })
                }</time
              >
            </div>
            <span>BY_WALTER_SOCA</span>
          </div>
        </header>

        <div class="p-8 md:p-12">
          <img
            src={post.data.image}
            alt={post.data.title}
            class="w-full aspect-video object-cover border-4 border-black dark:border-white shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] mb-12 grayscale group-hover:grayscale-0 transition-all"
          />

          <div class="prose-retro prose dark:prose-invert max-w-none">
            <Content />
          </div>
        </div>
      </article>
    </div>
  </main>
</Layout>

<style is:global>
  /* Tipografía Brutalista para el contenido del blog */
  .prose-retro {
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .prose-retro h2,
  .prose-retro h3 {
    font-family: "Archivo Black", sans-serif;
    text-transform: uppercase;
    letter-spacing: -0.05em;
    color: #000;
    margin-top: 2.5rem;
  }

  .dark .prose-retro h2,
  .dark .prose-retro h3 {
    color: #fff;
  }

  .prose-retro h2 {
    font-size: 2rem;
    border-left: 8px solid #2563eb;
    padding-left: 1rem;
  }

  /* Code Blocks Estilo Terminal */
  .prose-retro pre {
    background-color: #000 !important;
    border: 4px solid #333;
    border-radius: 0 !important;
    padding: 1.5rem !important;
    box-shadow: 8px 8px 0px 0px #2563eb;
    margin: 2rem 0;
  }

  .prose-retro code {
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-weight: 700 !important;
  }

  .prose-retro :not(pre) > code {
    background-color: #fde047 !important;
    color: #000 !important;
    padding: 0.2rem 0.5rem !important;
    border: 2px solid #000;
    font-size: 0.9em;
  }

  .prose-retro blockquote {
    border-left: 0;
    background-color: #f3f4f6;
    border: 4px solid #000;
    padding: 1.5rem;
    font-style: italic;
    box-shadow: 6px 6px 0px 0px #000;
  }

  .dark .prose-retro blockquote {
    background-color: #111;
    border-color: #fff;
    box-shadow: 6px 6px 0px 0px #fff;
  }
</style>
