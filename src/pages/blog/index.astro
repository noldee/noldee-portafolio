---
import Layout from "@/layout/Layout.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog | Walter Soca">
  <section
    class="py-12 md:py-24 bg-white relative overflow-hidden min-h-screen"
  >
    <div
      class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,#f0f0f0_1px,transparent_1px),linear-gradient(to_bottom,#f0f0f0_1px,transparent_1px)] bg-[size:4rem_4rem] md:bg-[size:6rem_4rem]"
    >
      <div
        class="absolute inset-0 bg-white [mask-image:radial-gradient(ellipse_80%_60%_at_50%_0%,#000_70%,transparent_100%)]"
      >
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <header
        class="flex flex-col md:flex-row md:items-end justify-between mb-12 md:mb-20 gap-6"
      >
        <div class="space-y-4">
          <a
            href="/"
            class="group inline-flex items-center gap-2 text-gray-400 hover:text-blue-600 transition-colors text-xs font-bold uppercase tracking-widest"
          >
            <svg
              class="size-4 transition-transform group-hover:-translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
            >
            Regresar
          </a>
          <h1
            class="text-5xl sm:text-6xl md:text-8xl font-extrabold text-black tracking-tighter leading-[0.9] md:leading-[0.8]"
          >
            Dev<span class="text-blue-600">Log</span><span class="text-gray-200"
              >.</span
            >
          </h1>
          <p
            class="text-gray-500 max-w-sm md:max-w-md text-base md:text-lg leading-relaxed"
          >
            Documentando mi viaje por <span
              class="text-black font-semibold italic">Go</span
            >, automatización con <span class="text-black font-semibold italic"
              >Bash</span
            > y desarrollo moderno.
          </p>
        </div>

        <div
          class="hidden sm:flex items-center gap-3 bg-blue-50/50 border border-blue-100 px-4 py-2 rounded-2xl w-fit"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"
            ></span>
          </span>
          <span
            class="text-blue-700 text-[10px] md:text-xs font-bold uppercase tracking-wider"
            >Aprendiendo Go v1.22</span
          >
        </div>
      </header>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-6 md:gap-8"
        id="blog-grid"
      >
        {
          posts.map((post, index) => {
            const isFeatured = index === 0;
            return (
              <a
                href={`/blog/${post.slug}`}
                class={`group blog-card opacity-0 translate-y-8 flex flex-col ${isFeatured ? "lg:col-span-8 sm:col-span-2" : "lg:col-span-4 sm:col-span-1"}`}
              >
                <article class="relative flex flex-col h-full border border-gray-100 rounded-[2rem] md:rounded-[2.5rem] bg-white overflow-hidden transition-all duration-500 hover:border-blue-200 hover:shadow-2xl hover:shadow-blue-50/50">
                  <div
                    class={`relative overflow-hidden ${isFeatured ? "aspect-video lg:aspect-[21/9]" : "aspect-video"}`}
                  >
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      loading={index < 3 ? "eager" : "lazy"}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                  </div>

                  <div class="p-6 md:p-8 flex flex-col flex-1">
                    <div class="flex flex-wrap gap-2 mb-4">
                      {post.data.tags.slice(0, 3).map((tag) => (
                        <span class="text-[9px] md:text-[10px] font-black uppercase tracking-[0.15em] text-blue-600 bg-blue-50 px-2.5 py-1 rounded-full border border-blue-100/50">
                          {tag}
                        </span>
                      ))}
                    </div>

                    <h2
                      class={`${isFeatured ? "text-2xl md:text-4xl" : "text-xl md:text-2xl"} font-bold text-black mb-3 md:mb-4 tracking-tight leading-tight group-hover:text-blue-600 transition-colors line-clamp-2`}
                    >
                      {post.data.title}
                    </h2>

                    <p class="text-gray-500 text-sm md:text-base line-clamp-2 mb-6 md:mb-8 flex-1">
                      {post.data.description}
                    </p>

                    <div class="flex items-center justify-between pt-4 md:pt-6 border-t border-gray-50">
                      <div class="flex items-center gap-2 text-[10px] md:text-xs font-bold text-gray-400 uppercase tracking-widest">
                        <svg
                          class="size-3.5 md:size-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                          />
                        </svg>
                        {post.data.pubDate.toLocaleDateString("es-ES", {
                          month: "short",
                          day: "numeric",
                          year: "numeric",
                        })}
                      </div>
                      <div class="size-8 md:size-10 rounded-full bg-black flex items-center justify-center text-white transition-all group-hover:translate-x-1 group-hover:bg-blue-600">
                        <svg
                          class="size-4 md:size-5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="3"
                          viewBox="0 0 24 24"
                        >
                          <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                        </svg>
                      </div>
                    </div>
                  </div>
                </article>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("DOMContentLoaded", () => {
    // Animación de entrada para las tarjetas con Stagger
    gsap.to(".blog-card", {
      opacity: 1,
      y: 0,
      duration: 1,
      stagger: 0.15,
      ease: "power4.out",
      scrollTrigger: {
        trigger: "#blog-grid",
        start: "top 85%",
      },
    });
  });
</script>

<style>
  .blog-card {
    will-change: transform, opacity;
  }
</style>
