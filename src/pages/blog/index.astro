---
import Layout from "@/layout/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog | Walter Soca">
  <section class="min-h-screen py-20 bg-[#0b0b0c]">
    <div class="max-w-5xl mx-auto px-4">

      <!-- Header de la Página -->
      <header class="mb-16">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs font-mono text-[#8c8c93] hover:text-[#fbebca] transition-colors mb-10 group"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          [00] regresar_al_inicio
        </a>

        <div class="flex items-end justify-between gap-6 flex-wrap">
          <div>
            <h1 class="text-4xl md:text-5xl font-bold text-[#fbebca] tracking-tight">
              DevLog
            </h1>
            <p class="text-xs font-mono text-[#8c8c93] mt-1">
              bitácora de infraestructura, código y notas de desarrollo
            </p>
          </div>
          <p class="text-[#8c8c93] text-xs sm:text-sm max-w-sm leading-relaxed pb-1 font-normal">
            Notas honestas sobre Spring Boot, PHP, TypeScript, automatización y el hermoso caos del software moderno.
          </p>
        </div>

        <div class="h-px bg-[#222225] mt-8"></div>
      </header>

      <!-- Grid de posts (Tarjetas con separación limpia) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="blog-grid">
        {
          posts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="blog-card group bg-[#131315] border border-[#222225] rounded-2xl p-5 flex flex-col justify-between hover:border-[#8c8c93]/30 transition-all duration-300 shadow-xl"
            >
              <div>
                <!-- Contenedor de Imagen Redondeado -->
                <div class="aspect-video overflow-hidden mb-4 bg-[#0b0b0c] rounded-xl border border-[#222225]">
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    class="w-full h-full object-cover opacity-60 group-hover:opacity-100 grayscale group-hover:grayscale-0 transition-all duration-500 scale-100 group-hover:scale-[1.02]"
                  />
                </div>

                <!-- Tags estilo consola -->
                <div class="flex flex-wrap gap-1.5 mb-3">
                  {post.data.tags.map((tag: string) => (
                    <span class="text-[10px] font-mono text-[#8c8c93] bg-[#0b0b0c] border border-[#222225] px-2 py-0.5 rounded-md">
                      #{tag.toLowerCase()}
                    </span>
                  ))}
                </div>

                <!-- Título -->
                <h2 class="text-base font-bold text-[#fbfaf7] leading-snug mb-2 group-hover:text-[#fbebca] transition-colors line-clamp-2">
                  {post.data.title}
                </h2>

                <!-- Descripción corta -->
                <p class="text-xs text-[#8c8c93] line-clamp-2 mb-6 leading-relaxed">
                  {post.data.description}
                </p>
              </div>

              <!-- Footer de la tarjeta -->
              <div class="flex items-center justify-between pt-3 border-t border-[#222225] mt-auto">
                <time class="text-[11px] font-mono text-[#8c8c93]">
                  {post.data.pubDate.toLocaleDateString("es-ES", {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })}
                </time>
                <span class="text-[11px] font-mono text-[#fbebca] group-hover:text-[#fbfaf7] transition-colors flex items-center gap-1">
                  read.sh <span class="transform group-hover:translate-x-0.5 transition-transform">→</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <!-- Estado vacío (Empty state) -->
      {posts.length === 0 && (
        <div class="text-center py-20 border border-[#222225] bg-[#131315] rounded-2xl">
          <p class="text-[#8c8c93] font-mono text-xs">// stdout: no logs found in directory</p>
        </div>
      )}

    </div>
  </section>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // Asegura la ejecución en el ciclo de vida de Astro con View Transitions si los usas
  const initAnimation = () => {
    const cards = document.querySelectorAll(".blog-card");
    if (cards.length > 0) {
      gsap.from(cards, {
        y: 15,
        opacity: 0,
        duration: 0.4,
        stagger: 0.06,
        ease: "power2.out",
        scrollTrigger: {
          trigger: "#blog-grid",
          start: "top 90%",
        },
      });
    }
  };

  window.addEventListener("DOMContentLoaded", initAnimation);
</script>