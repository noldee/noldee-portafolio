---
import Layout from "@/layout/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title="Blog | Walter Soca">
  <section class="min-h-screen py-24">
    <div class="max-w-5xl mx-auto px-6">

      <!-- Header -->
      <header class="mb-20">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs font-mono text-[var(--text-muted)] hover:text-[var(--green)] transition-colors mb-10 group"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          volver al inicio
        </a>

        <div class="flex items-end justify-between gap-6 flex-wrap">
          <div>
            <span class="text-xs font-mono text-[var(--green)] tracking-widest uppercase mb-4 block"></span>
            <h1 class="text-6xl md:text-8xl font-display text-[var(--text)] leading-none tracking-tight">
              DevLog
            </h1>
          </div>
          <p class="text-[var(--text-muted)] text-sm max-w-xs leading-relaxed pb-2">
            Notas sobre React, TypeScript, automatización y el caos del software moderno.
          </p>
        </div>

        <div class="h-px bg-[var(--border)] mt-10"></div>
      </header>

      <!-- Grid de posts -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--border)]" id="blog-grid">
        {
          posts.map((post, index) => (
            <a
              href={`/blog/${post.slug}`}
              class="blog-card group bg-[var(--bg)] hover:bg-[var(--surface)] transition-colors p-6 flex flex-col"
            >
              <!-- Imagen -->
              <div class="aspect-video overflow-hidden mb-5 bg-[var(--surface-2)]">
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-full object-cover opacity-50 group-hover:opacity-80 grayscale group-hover:grayscale-0 transition-all duration-500 scale-105 group-hover:scale-100"
                />
              </div>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2 mb-3">
                {post.data.tags.map((tag: string) => (
                  <span class="text-[10px] font-mono text-[var(--text-muted)] border border-[var(--border)] px-2 py-0.5">
                    #{tag}
                  </span>
                ))}
              </div>

              <!-- Título -->
              <h2 class="text-xl font-display text-[var(--text)] leading-tight mb-3 group-hover:text-[var(--green)] transition-colors flex-1">
                {post.data.title}
              </h2>

              <!-- Descripción -->
              <p class="text-sm text-[var(--text-muted)] line-clamp-2 mb-6 leading-relaxed">
                {post.data.description}
              </p>

              <!-- Footer -->
              <div class="flex items-center justify-between pt-4 border-t border-[var(--border)]">
                <time class="text-xs font-mono text-[var(--text-muted)]">
                  {post.data.pubDate.toLocaleDateString("es-ES")}
                </time>
                <span class="text-xs font-mono text-[var(--green)] group-hover:underline">
                  leer →
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <!-- Empty state -->
      {posts.length === 0 && (
        <div class="text-center py-24 border border-[var(--border)]">
          <p class="text-[var(--text-muted)] font-mono text-sm">// sin posts aún</p>
        </div>
      )}

    </div>
  </section>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("DOMContentLoaded", () => {
    gsap.from(".blog-card", {
      y: 20,
      opacity: 0,
      duration: 0.5,
      stagger: 0.08,
      ease: "power2.out",
      scrollTrigger: {
        trigger: "#blog-grid",
        start: "top 85%",
      },
    });
  });
</script>