---
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Walter Soca | Portafolio",
  description = "Desarrollador de Software.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <title>{title}</title>
  </head>
  <body class="antialiased bg-[#121316] text-[#f4f4f6] min-h-screen">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg-main: #121316;      /* Fondo oscuro suave (no negro puro) */
    --bg-card: #1a1c23;      /* Gris mineral para los bloques */
    --border: #262930;       /* Bordes finos y limpios */
    --text-main: #f4f4f6;    /* Blanco tiza, suave para la vista */
    --text-muted: #8e939e;   /* Gris claro para textos secundarios */
    --accent: #6366f1;       /* Azul acero/índigo sutil solo para detalles */
  }

  html, body {
    background-color: var(--bg-main);
    color: var(--text-main);
    font-family: 'Inter', system-ui, sans-serif;
  }
</style>